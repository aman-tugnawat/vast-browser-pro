    <string name="mozac_browser_engine_system_alert_title">Faqja te %1$s thotë:</string>
    <string name="mozac_browser_engine_system_auth_message">%2$s po kërkon emrin tuaj të përdoruesit dhe fjalëkalimin. Sajti thotë: “%1$s”</string>
    <string name="mozac_browser_engine_system_auth_no_realm_message">%1$s po kërkon emrin tuaj të përdoruesit dhe fjalëkalimin.</string>
    <string name="mozac_browser_errorpages_connection_failure_message"><![CDATA[<ul>\n<li>Sajti mund të jetë përkohësisht jashtë funksionimit ose shumë i zënë. Riprovoni pas pak çastesh.</li>\n<li>Nëse s’jeni në gjendje të ngarkoni çfarëdo faqe, kontrolloni lidhjen me rrjetin celular, ose Wi-Fi të pajisjes tuaj.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_connection_failure_title">S’arrin të lidhet</string>
    <string name="mozac_browser_errorpages_content_crashed_message"><![CDATA[<p>Faqja që po rrekeni të shihni, s’mund të shfaqet, ngaqë u pikas një gabim në transmetimin e të dhënave.</p>\n<ul>\n<li>Ju lutemi, lidhuni me të zotët e sajtit që t’u njoftoni këtë problem.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_content_crashed_title">Vithisje lënde</string>
    <string name="mozac_browser_errorpages_corrupted_content_message"><![CDATA[<p>Faqja që po rrekeni të shihni, s’mund të shfaqet, ngaqë u pikas një gabim në transmetimin e të dhënave.</p>\n<ul>\n<li>Ju lutemi, lidhuni me të zotët e sajtit që t’u njoftoni këtë problem.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_corrupted_content_title">Gabim nga Lëndë e Dëmtuar</string>
    <string name="mozac_browser_errorpages_file_access_denied_message"><![CDATA[<ul>\n<li>Mund të jetë hequr, lëvizur, ose hyrjen e pengojnë lejet mbi kartelën.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_access_denied_title">Hyrja te kartela u mohua</string>
    <string name="mozac_browser_errorpages_file_not_found_message"><![CDATA[<ul>\n<li>Mundet që objekti të jetë riemërtuar, hequr, ose shpërngulur gjetkë?</li>\n<li>A ka ndonjë gabim shkrimi apo gabim tjetër tipografik te adresa?</li>\n<li>A keni leje të mjafta hyrjeje për te objekti i kërkuar?</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_not_found_title">S’u Gjet Kartelë</string>
    <string name="mozac_browser_errorpages_generic_message"><![CDATA[<p>Hëpërhë s’ka hollësi shtesë të gatshme rreth këtij problemi apo gabimi.</p>]]></string>
    <string name="mozac_browser_errorpages_generic_title">Kërkesa Nuk Plotësohet Dot</string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_message"><![CDATA[<p>Kjo faqe web te %1$s është bllokuar ngaqë një nga shtesat tuaja provoi ta hapë. Ky sajt mund të jetë duke u përdorur për të vjedhur informacion tuajin — bie fjala, fjalëkalime, ose numra kartash krediti.</p>]]></string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_title">Sajti u bllokuar për sigurinë tuaj</string>
    <string name="mozac_browser_errorpages_httpsonly_button">Vazhdo te Sajti HTTP</string>
    <string name="mozac_browser_errorpages_httpsonly_message"><![CDATA[Keni aktivizuar Mënyrën Vetëm-HTTPS, për siguri të thelluar dhe s’ka version HTTPS për <em>%1$s</em>.]]></string>
    <string name="mozac_browser_errorpages_httpsonly_title">S’ka Sajt të Siguruar</string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_message"><![CDATA[<p>Faqja që po rrekeni të shihni s’shfaqet dot, sepse përdor një formë ngjeshjeje të mangët, ose të pambuluar.</p>\n<ul>\n<li>Ju lutemi, lidhuni me të zotët e sajtit për t’u njoftuar këtë problem.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_title">Gabim Kodimi Lënde</string>
    <string name="mozac_browser_errorpages_malformed_uri_message"><![CDATA[<p>Adresa e dhënë nuk është sipas ndonjë formati të pranuar. Ju lutemi, kontrolloni për gabime te shtylla e vendeve dhe riprovoni.</p>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_message_alternative"><![CDATA[<ul>\n<li>Adresat Web zakonisht shkruhen si <strong>http://www.example.com/</strong></li>\n<li>Sigurohuni se po përdorni pjerrake djathtas (d.m.th., <strong>/</strong>).</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_title">Adresë e Pavlefshme</string>
    <string name="mozac_browser_errorpages_malformed_uri_title_alternative">Adresa s’është e vlefshme</string>
    <string name="mozac_browser_errorpages_net_interrupt_message"><![CDATA[<p>Shfletuesi u lidh me sukses, por lidhja u ndërpre teksa shpërnguleshin të dhëna. Ju lutemi, riprovoni.</p>\n<ul>\n<li>Sajti mund të jetë përkohësisht jashtë funksionimi, ose shumë i zënë. Riprovoni pas pak çastesh.</li>\n<li>Nëse s’jeni në gjendje të ngarkoni çfarëdo faqe, kontrolloni lidhjen me rrjetin celular, ose Wi-Fi të pajisjes tuaj.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_interrupt_title">Lidhja u ndërpre</string>
    <string name="mozac_browser_errorpages_net_reset_message"><![CDATA[<p>Ndërlidhja me rrjetin u ndërpre teksa negociohej një lidhje. Ju lutemi, riprovoni.</p>\n<ul>\n<li>Sajti mund të jetë përkohësisht jashtë funksionimi, ose shumë i zënë. Riprovoni pas pak çastesh.</li>\n<li>Nëse s’jeni në gjendje të ngarkoni çfarëdo faqe, kontrolloni lidhjen me rrjetin celular, ose Wi-Fi të pajisjes tuaj.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_reset_title">Lidhja u rivendos</string>
    <string name="mozac_browser_errorpages_net_timeout_message"><![CDATA[<p>Sajti i kërkuar s’iu përgjigj kërkesës për lidhje dhe shfletuesi reshti së prituri për përgjigje.</p>\n<ul>\n<li>Mundet që shërbyesi është duke u përballur me kërkesë të madhe, ose mundet të jetë përkohësisht jashtë loje? Riprovoni më vonë.</li>\n<li>S’jeni në gjendje të shfletoni sajte të tjerë? Kontrolloni lidhjen në rrjet të pajisjes.</li>\n<li>A është pajisja, ose rrjeti juaj i mbrojtur me një <em>firewall</em> apo ndërmjetës? Rregullime të pasakta mund të prekin shfletimin në Web.</li>\n<li>Keni ende vështirësi? Për ndihmë, lidhuni me administruesin e rrjetit tuaj, ose me furnizuesin e Internetit.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_timeout_title">Lidhjes i mbaroi koha</string>
    <string name="mozac_browser_errorpages_no_internet_error_code">Kod Gabimi: NS_ERROR_OFFLINE</string>
    <string name="mozac_browser_errorpages_no_internet_message_2">Provoni të lidheni që nga një pajisje tjetër. Shihni modemin ose rrugëzuesin tuaj. Shkëputuni dhe rilidhuni me Wi-Fi-n.</string>
    <string name="mozac_browser_errorpages_no_internet_refresh_button">Ringarkoje</string>
    <string name="mozac_browser_errorpages_no_internet_title_2">Duket se ka një problem me lidhjen tuaj në internet</string>
    <string name="mozac_browser_errorpages_offline_message"><![CDATA[<p>Shfletuesi po punon nën mënyrën jashtë linje dhe s’lidhet dot te objekti i kërkuar.</p>\n<ul>\n<li>A është pajisja e lidhur te një rrjet aktiv?</li>\n<li>Shtypni “Riprovoni” që të kalohet nën mënyrën “Në linjë” dhe të ringarkohet faqja.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_offline_title">Mënyrë Jo Në Linjë</string>
    <string name="mozac_browser_errorpages_page_refresh">Riprovoni</string>
    <string name="mozac_browser_errorpages_port_blocked_message"><![CDATA[<p>Adresa e kërkuar donte një portë (p.sh., <q>mozilla.org:80</q> për portën 80 te mozilla.org) normalisht e përdorur për qëllime <em>të tjera</em> dhe jo për shfletim Web. Shfletuesi e anuloi kërkesën me qëllim mbrojtjen dhe sigurinë tuaj.</p>]]></string>
    <string name="mozac_browser_errorpages_port_blocked_title">Portë e kufizuar për arsye sigurie</string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_message"><![CDATA[<p>Shfletuesi është formësuar të përdorë shërbyes ndërmjetës, por ndërmjetësi s’pranoi lidhje.</p>\n<ul>\n<li>Është i saktë formësimi i shfletuesit për ndërmjetësin? Kontrolloni rregullimet dhe riprovoni.</li>\n<li>A lejon shërbimi ndërmjetës lidhje prej këtij rrjeti?</li>\n<li>Keni ende vështirësi? Për ndihmë, lidhuni me administruesin e rrjetit tuaj, ose me furnizuesin e Internetit.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_title">Shërbyesi Ndërmjetës Hodhi Poshtë Kërkesën për Lidhje</string>
    <string name="mozac_browser_errorpages_redirect_loop_message"><![CDATA[<p>Shfletuesi ka reshtur së provuari të marrë objektin e kërkuar. Sajti po e ridrejton kërkesën në një mënyrë që s’do të plotësohet kurrë.</p>\n<ul>\n<li>I keni çaktivizuar apo bllokuar cookie-t e domosdoshme për këtë sajt?</li>\n<li>Nëse pranimi i cookie-ve s’e zgjidh problemin, ka të ngjarë të jetë çështje formësimi shërbyesi dhe jo e pajisjes tuaj.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_redirect_loop_title">Faqja s’është ridrejtuar si duhet</string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_message"><![CDATA[<p>Sajti te %1$s është raportuar si sajt sulmesh dhe është bllokuar bazuar në parapëlqimet tuaja për sigurinë.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_title">Problem sajti malware-i</string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_message"><![CDATA[<p>Sajti te %1$s është raportuar se shërben <em>software</em> të padëshiruar dhe është bllokuar bazuar në parapëlqimet tuaja për sigurinë.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_title">Problem sajti të padëshiruar</string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_message"><![CDATA[<p>Sajti te %1$s është raportuar si sajt potencialisht i dëmshëm dhe është bllokuar bazuar në parapëlqimet tuaja për sigurinë.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_title">Problem sajti të dëmshëm</string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_message"><![CDATA[<p>Kjo faqe web te %1$s është raportuar si sajt i rremë dhe është bllokuar bazuar në parapëlqimet tuaja për sigurinë.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_title">Problem sajti të rremë</string>
    <string name="mozac_browser_errorpages_security_bad_cert_accept_temporary">Pranoni Rrezikun dhe Vazhdoni</string>
    <string name="mozac_browser_errorpages_security_bad_cert_advanced">Të mëtejshme…</string>
    <string name="mozac_browser_errorpages_security_bad_cert_back">Kthehuni Mbrapsht (E këshilluar)</string>
    <string name="mozac_browser_errorpages_security_bad_cert_message"><![CDATA[<ul>\n<li>Mund të jetë problem i formësimit të shërbyesit, ose mundet që dikush të jetë duke imituar shërbyesin.</li>\n<li>Nëse në të kaluarën jeni lidhur me sukses te ky shërbyes, gabimi mund të jetë i përkohshëm dhe mund të riprovonit më vonë.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_techInfo"><![CDATA[<label>Dikush mund të jetë duke provuar të imitojë sajtin dhe s’duhet të vazhdoni.</label> <br><br>\n<label>Sajtet dëshmojnë identitetin e tyre përmes dëshmish. %1$s nuk i zë besë <b>%2$s</b>, ngaqë lëshuesi i dëshmisë së tij është i panjohur, dëshmia është e vetënënshkruar, ose shërbyesi s’po dërgon dëshmi të ndërmjetme të sakta.</label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_title">Dështoi Lidhja e Siguruar</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_advanced">Të mëtejshme…</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_back">Kthehu Mbrapsht</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_message"><![CDATA[<ul>\n<li>Faqja që po rrekeni të shihni, s’mund të shfaqet, ngaqë ky sajt lyp një lidhje të siguruar.</li>\n<li>Gjasat janë që problemi të jetë me sajtin dhe s’ka gjë që mund ta bëni për ta zgjidhur.</li>\n<li>Mund të njoftoni përgjegjësin e sajtit për problemin.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_techInfo2"><![CDATA[<label><b>%1$s</b> përmban një rregull sigurie të quajtur HTTP Strict Transport Security (HSTS), që do të thotë se <b>%2$s</b>-i mund të lidhet me të vetëm nën mënyrë të siguruar. S’shtoni dot një përjashtim që të vizitoni këtë sajt. </label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_title">Ky sajt lyp një lidhje të siguruar.</string>
    <string name="mozac_browser_errorpages_security_ssl_message"><![CDATA[<ul>\n<li>Faqja që po provoni të shihni s’shfaqet dot, ngaqë mirëfilltësia e të dhënave të marra s’u vërtetua dot.</li>\n<li>Ju lutemi, lidhuni me të zotët e sajtit, për t’u bërë të ditur këtë problem.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_ssl_title">Dështoi Lidhja e Siguruar</string>
    <string name="mozac_browser_errorpages_unknown_host_message"><![CDATA[<p>Shfletuesi s’gjeti dot shërbyesin strehë për adresën e dhënë.</p>\n<ul>\n<li>Kontrolloni adresën për gabime shkrimi, bie fjala, <strong>ww</strong>.example.com në vend të <strong>www</strong>.example.com.</li>\n<li>Nëse s’jeni në gjendje të ngarkoni çfarëdo faqe, kontrolloni lidhjen e pajisjes tuaj me rrjetin celular, ose atë Wi-Fi.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_host_title">S’u Gjet Adresë</string>
    <string name="mozac_browser_errorpages_unknown_protocol_message"><![CDATA[<p>Adresa tregon një protokoll (p.sh., <q>wxyz://</q>) të cilin shfletuesi s’e njeh, kështu që s’mund të lidhet si duhet me këtë sajt.</p>\n<ul>\n<li>Mos po përpiqeni të hapni shërbime multimedia apo shërbim tjetër jo tekst? Shihni te sajti për domosdoshmëri ekstra.</li>\n<li>Disa protokolle mund të lypin <em>software</em> ose shtojca prej palësh të treta, përpara se shfletuesi të mund t’i njohë.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_protocol_title">Protokoll i Panjohur</string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_message"><![CDATA[<p>Shfletuesi është formësuar të përdorë një shërbyes ndërmjetës, por ndërmjetësi s’u gjet dot.</p>\n<ul>\n<li>Është i saktë formësimi i shfletuesit për ndërmjetësin? Kontrolloni rregullimet dhe riprovoni.</li>\n<li>A është e lidhur pajisja te një rrjet aktiv?</li>\n<li>Keni ende vështirësi? Për ndihmë, lidhuni me administruesin e rrjetit tuaj, ose me furnizuesin e Internetit.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_title">S’u Gjet Shërbyes Ndërmjetës</string>
    <string name="mozac_browser_errorpages_unknown_socket_type_message"><![CDATA[<p>Sajti iu përgjigj kërkesës së rrjetit në një mënyrë të papritur dhe shfletuesi s’vazhdon dot.</p>]]></string>
    <string name="mozac_browser_errorpages_unknown_socket_type_title">Përgjigje e papritur prej shërbyesit</string>
    <string name="mozac_browser_errorpages_unsafe_content_type_message"><![CDATA[<ul>\n<li>Ju lutemi, lidhuni me të zotët e sajtit, për t’u bërë të ditur këtë problem.</li>\n</ul>]]></string>
