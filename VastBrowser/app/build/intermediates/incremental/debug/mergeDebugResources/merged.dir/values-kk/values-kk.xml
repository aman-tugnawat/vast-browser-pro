    <string name="mozac_browser_engine_system_alert_title">%1$s адресіндегі бет хабарлайды:</string>
    <string name="mozac_browser_engine_system_auth_message">%2$s сайты сіздің пайдаланушы атын мен паролін сұрайды. Сайт айтады: \"%1$s\"</string>
    <string name="mozac_browser_engine_system_auth_no_realm_message">%1$s сіздің пайдаланушы атын және паролін сұрап тұр.</string>
    <string name="mozac_browser_errorpages_connection_failure_message"><![CDATA[<ul>\n<li>Сайт уақытша қолжетімсіз, немесе сұранымдарға толы шығар. Кейінірек қайталап көріңіз.</li>\n<li>Бірде-бір сайт ашылмаса, мобильді құрылғыңыздың деректер не Wi-Fi байланысын тексеріңіз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_connection_failure_title">Байланысты орнату мүмкін емес</string>
    <string name="mozac_browser_errorpages_content_crashed_message"><![CDATA[<p>Сіз қараймын деген парақ көрсетілмейді, өйткені мәліметтер тасымалданған кезде қате анықталды.</p>\n<ul>\n<li>Веб сайт иелеріне осы мәселе жөнінде хабарлаңыз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_content_crashed_title">Құрамасы бұзылды</string>
    <string name="mozac_browser_errorpages_corrupted_content_message"><![CDATA[<p>Сіз қараймын деген парақ көрсетілмейді, өйткені мәліметтер тасымалданған кезде қате анықталды.</p>\n<ul>\n<li>Веб сайт иелеріне осы мәселе жөнінде хабарлаңыз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_corrupted_content_title">Зақымдалған құрама қатесі</string>
    <string name="mozac_browser_errorpages_file_access_denied_message"><![CDATA[<ul>\n<li>Ол өшірілген, жылжытылған немесе файл рұқсаттары қатынауға жол бермеуі мүмкін.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_access_denied_title">Файлға қатынау құқығы жоқ</string>
    <string name="mozac_browser_errorpages_file_not_found_message"><![CDATA[<ul>\n<li>Ол нәрсенің аты ауысқан, ол өшірілген не орны ауысқан болуы мүмкін бе?</li>\n<li>Адрес ішінде айтылу не жазылу қателері не басқа қателер жоқ па?</li>\n<li>Сұранған нәрсеге сізде керек рұқсаттар бар ма?</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_not_found_title">Файл табылмады</string>
    <string name="mozac_browser_errorpages_generic_message"><![CDATA[<p>Бұл қате жөнінде қосымша ақпарат қазір қолжетерсіз.</p>]]></string>
    <string name="mozac_browser_errorpages_generic_title">Сұранымды аяқтау мүмкін емес</string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_message"><![CDATA[<p>%1$s веб-беті бұғатталған, себебі сіздің қосымшаларыңыздың бірі оны ашуға тырысты. Бұл сайт парольдер немесе несие карталарының нөмірлері сияқты ақпаратыңызды ұрлау үшін пайдаланылуы мүмкін.</p>]]></string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_title">Бұл сайт сіздің қауіпсіздігіңіз үшін бұғатталған</string>
    <string name="mozac_browser_errorpages_httpsonly_button">HTTP сайтына өту</string>
    <string name="mozac_browser_errorpages_httpsonly_message"><![CDATA[Сіз жақсартылған қауіпсіздік үшін тек-HTTPS режимін іске қосқансыз, бірақ, <em>%1$s</em> адресінің HTTPS нұсқасы қолжетімсіз.]]></string>
    <string name="mozac_browser_errorpages_httpsonly_title">Қауіпсіз сайт қолжетімді емес</string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_message"><![CDATA[<p>Сіз сұраған бет көрсетілмейді, өйткені оның сығуы қате немесе браузер оны қолдамайды.</p>\n<ul>\n<li>Веб-сайттың иесімен осы мәселе жайында хабарласыңыз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_title">Құраманы декодтау кезінде қате кетті</string>
    <string name="mozac_browser_errorpages_malformed_uri_message"><![CDATA[<p>Енгізілген адрестің пішімі қате. Оның енгізілуін тексеріп, қайта көріңіз.</p>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_message_alternative"><![CDATA[<ul>\n<li>Веб адрестері әдетте келесідей жазылады - <strong>http://www.example.com/</strong></li>\n<li>Қалыпты слэштер қолданатыңызға көз жеткізіңіз (мыс. <strong>/</strong>).</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_title">Адрес пішімі қате</string>
    <string name="mozac_browser_errorpages_malformed_uri_title_alternative">Адрес пішімі қате</string>
    <string name="mozac_browser_errorpages_net_interrupt_message"><![CDATA[<p>Браузер сәтті байланысқан, бірақ, байланыс ақпаратты тасымалдау кезінде үзілген. Қайталап көріңіз.</p>\n<ul>\n<li>Сайт уақытша қолжетімсіз немесе сұранымдарға толы шығар. Біраздан кейін қайталап көріңіз.</li>\n<li>Егер бірде-бір парақ жүктелмесе, құрылғының деректер немесе Wi-Fi байланысын тексеріңіз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_interrupt_title">Байланыс үзілген</string>
    <string name="mozac_browser_errorpages_net_reset_message"><![CDATA[<p>Байланысты орнату кезінде желілік байланыс үзілді. Қайталап көріңіз.</p>\n<ul>\n<li>Сайт уақытша қолжетімсіз немесе сұранымдарға толы шығар. Біраздан кейін қайталап көріңіз.</li>\n<li>Егер бірде-бір парақ жүктелмесе, құрылғының деректер немесе Wi-Fi байланысын тексеріңіз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_reset_title">Байланыс үзілген</string>
    <string name="mozac_browser_errorpages_net_timeout_message"><![CDATA[<p>Көрсетілген сайтпен байланыс орнату сұранымына жауап бермеді және браузердің күту уақыты бітті.</p>\n<ul>\n<li>Сайт сервері тым жүктелген немесе уақытша жұмыстан тыс болуы мүмкін бе? Біраз уақыт күтіп, қайталап көріңіз.</li>\n<li>Егер сіз басқа да сайттарды аша алмасаңыз, компьютеріңіздің желімен байланысын тексеріңіз.</li>\n<li>Егер құрылғыңыз желіаралық экран немесе прокси-сервермен қорғалса, олардың баптауларын тексеріңіз.</li>\n<li>Егер басқа да мәселелер пайда болса, жүйелік администраторыңызға не Интернет-провайдеріңізге хабарласыңыз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_timeout_title">Байланысты күту уақыты аяқталды</string>
    <string name="mozac_browser_errorpages_no_internet_error_code">Қате коды: NS_ERROR_OFFLINE</string>
    <string name="mozac_browser_errorpages_no_internet_message_2">Басқа құрылғыда байланысып көріңіз. Модемді немесе маршрутизаторды тексеріңіз. Wi-Fi желісіне байланысты ажыратып, оған қайта қосылыңыз.</string>
    <string name="mozac_browser_errorpages_no_internet_refresh_button">Қайта жүктеу</string>
    <string name="mozac_browser_errorpages_no_internet_title_2">Интернет байланысыңызда мәселе бар сияқты</string>
    <string name="mozac_browser_errorpages_offline_message"><![CDATA[<p>Браузер қазір дербес жұмыс істеу режимінде, сол үшін сұранған нәрсеге байланыс орната алмайды.</p>\n<ul>\n<li>Бұл құрылғы белсенді желіге қосулы тұр ма?</li>\n<li>Онлайн режиміне ауысып, парақты жаңарту үшін, \"Қайталап көру\" басыңыз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_offline_title">Дербес жұмыс режимі</string>
    <string name="mozac_browser_errorpages_page_refresh">Қайталап көру</string>
    <string name="mozac_browser_errorpages_port_blocked_message"><![CDATA[<p>Сұранған байланыс үшін көрсетілген порт (мысалы: <q>mozilla.org:80</q> бұл mozilla.org сайтындағы 80 порт) әдетте веб-сайттармен байланысу үшін <em>қолданылмайды</em>. Қауіпсіздік мақсатында браузер бұл байланысты үзді.</p>]]></string>
    <string name="mozac_browser_errorpages_port_blocked_title">Порт қауіпсіздік мақсатында шектелген</string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_message"><![CDATA[<p>Браузер прокси-сервер қолдануға бапталған, бірақ прокси-сервер байланыс орнатуға рұқсат бермейді.</p>\n<ul>\n<li>Браузердегі прокси-сервер баптаулары дұрыс па? Оларды тексеріп, қайталап көріңіз.</li>\n<li>Прокси-сервер осы желіден байланыс орнатуға рұқсат бере ме?</li>\n<li>Әлі де мәселелер бар ма? Жүйелік администраторыңызбен, не Интернет-провайдеріңізбен хабарласыңыз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_title">Прокси-сервер сұранымды үзген</string>
    <string name="mozac_browser_errorpages_redirect_loop_message"><![CDATA[<p>Браузер парақтың жүктелуін тоқтатты, өйткені сайт сұранымды ешқашан аяқталмайтындықтай бағдарлайтыны анықталды.</p>\n<ul>\n<li>Бұл сайт сұраған cookies өшірген немесе бұғаттаған жоқсыз ба?</li>\n<li>Егер сайттан cookies қабылдау мүмкіндігін қосу арқылы мәселе шешілмесе, онда бұл қате серверден кеткен шығар.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_redirect_loop_title">Парақтағы қайта бағдарлау дұрыс емес</string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_message"><![CDATA[<p>%1$s сайты пайдаланушыларға шабуыл жасау үшін қолданылытыны туралы ақпарат бар, сондықтан қауіпсіздік баптауларыңызға сәйкес ол бұғатталды.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_title">Зиянкес бағдарлама сайты</string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_message"><![CDATA[<p>%1$s сайты ұнамсыз бағдарламалық қамтаманы тарататыны туралы ақпарат бар, сондықтан қауіпсіздік баптауларыңызға сәйкес ол бұғатталды.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_title">Зиянкес бағдарлама сайты</string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_message"><![CDATA[<p>%1$s сайты зиянкес болу мүмкіншілігі туралы ақпарат бар, сондықтан қауіпсіздік баптауларыңызға сәйкес ол бұғатталды..</p>]]></string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_title">Зиянкес сайт мәселесі</string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_message"><![CDATA[<p>%1$s сайты жалған сайт екені туралы ақпарат бар, сондықтан қауіпсіздік баптауларыңызға сәйкес ол бұғатталды.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_title">Жалған сайт мәселесі</string>
    <string name="mozac_browser_errorpages_security_bad_cert_accept_temporary">Тәуекелді қабылдап, жалғастыру</string>
    <string name="mozac_browser_errorpages_security_bad_cert_advanced">Кеңейтілген…</string>
    <string name="mozac_browser_errorpages_security_bad_cert_back">Артқа оралу (ұсынылады)</string>
    <string name="mozac_browser_errorpages_security_bad_cert_message"><![CDATA[<ul>\n<li>Бұл сервердің қатесі болуы мүмкін, немесе біреу сізге керек серверді басқасымен ауыстырғысы келеді.</li>\n<li>Осыған дейін осы серверге сәтті қосылған болсаңыз, осы қате уақытша болуы мүмкін. Біраздан кейін қайталап көріңіз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_techInfo"><![CDATA[<label>Біреу бұл сайтты еліктеу талабын жасап жатқаны мүмкін, сондықтан жалғастырмауыңыз керек.</label> <br><br>\n<label>Веб-сайттар өз шынайылығын сертификаттар арқылы көрсетеді. %1$s қолданбасы <b>%2$s</b> адресіне сенбейді, өйткені сертификат шығарушысы белгісіз, сертификат қолтаңбасы өздігінен қойылған, немесе сервер аралық сертификаттарды жібермеген.</label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_title">Қорғалған байланысты орнату сәтсіз аяқталды</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_advanced">Қосымша…</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_back">Артқа</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_message"><![CDATA[<ul>\n<li>Сіз көргіңіз келетін бетті көрсету мүмкін емес, себебі бұл веб-сайт қауіпсіз байланысты талап етеді.</li>\n<li>Мәселе веб-сайтта болуы мүмкін және оны шешу үшін ештеңе істей алмайсыз.</li>\n<li>Веб-сайттың әкімшісіне мәселе туралы хабарлауға болады.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_techInfo2"><![CDATA[<label> <b>%1$s</b> сайтының HTTP Strict Transport Security (HSTS) деп аталатын қауіпсіздік саясаты бар, бұл дегеніміз, <b>%2$s</b> оған тек қауіпсіз түрде байланыса алады. Бұл веб-сайт үшін ережеден тыс жағдайды қоса алмайсыз.</label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_title">Бұл веб-сайт қауіпсіз байланысты талап етеді.</string>
    <string name="mozac_browser_errorpages_security_ssl_message"><![CDATA[<ul>\n<li>Сіз сұраған парақ көрсетілмейді, өйткені алынған мәліметтер шынайылығын тексеру мүмкін емес.</li>\n<li>Сайт иесіне осы мәселе жөнінде хабарлаңыз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_ssl_title">Қорғалған байланысты орнату сәтсіз аяқталды</string>
    <string name="mozac_browser_errorpages_unknown_host_message"><![CDATA[<p>Браузер көрсетілген адрес үшін хост атын таба алмады.</p>\n<ul>\n<li>Адресті теру қателеріне тексеріңіз, мысалы <strong>www</strong>.example.com орнына <strong>ww</strong>.example.com.</li>\n<li>Бірде-бір парақ жүктелмесе, құрылғының деректер немесе Wi-Fi байланысын тексеріңіз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_host_title">Адрес табылмады</string>
    <string name="mozac_browser_errorpages_unknown_protocol_message"><![CDATA[<p>Көрсетілген адрес браузерге белгсіз хаттамадан (<q>wxyz://</q> сияқты) басталады, сондықтан браузер сайтпен байланыс орната алмайды.</p>\n<ul>\n<li>Егер сіз мультимедиа немесе басқа да мәтіндік емес сервистері бар сайтпен байланыс орнатсаңыз, сайттың бағдарламалық қамтамаға қойылатын талаптарын тексеріңіз.</li>\n<li>Браузер кейбір хаттамаларды қолдана алу үшін сыртқы бағдарламалық қамтаманы немесе плагиндерді орнату керек.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_protocol_title">Белгісіз хаттама</string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_message"><![CDATA[<p>Браузер прокси-серверді қолдануға бапталған, бірақ прокси-серверді табу мүмкін емес.</p>\n<ul>\n<li>Браузердің прокси-сервер баптаулары дұрыс па? Оларды тексеріп, қайталап көріңіз.</li>\n<li>Құрылғы белсенді желіге байланысып тұр ма?</li>\n<li>Әлі де мәселелер бар ма? Жүйелік администраторыңызбен, не Интернет-провайдеріңізбен хабарласыңыз.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_title">Прокси-сервер табылмады</string>
    <string name="mozac_browser_errorpages_unknown_socket_type_message"><![CDATA[<p>Сайт сұранымға күтпеген түрде жауап берді, браузер өз жұмысын жалғастыра алмайды.</p>]]></string>
    <string name="mozac_browser_errorpages_unknown_socket_type_title">Сервердің жауабы күтпеген түрде</string>
    <string name="mozac_browser_errorpages_unsafe_content_type_message"><![CDATA[<ul>\n<li>Веб сайт иелеріне осы мәселе жөнінде хабарлаңыз.</li>\n</ul>]]></string>
