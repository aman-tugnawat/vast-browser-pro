    <string name="mozac_browser_errorpages_connection_failure_message"><![CDATA[<ul>\n<li>A webhely ideiglenesen nem érhető el, vagy túl elfoglalt. Próbálja újra néhány pillanat múlva.</li>\n<li>Ha nem tölt be egyetlen oldal sem, akkor ellenőrizze a mobileszköz adat- vagy Wi-Fi kapcsolatát.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_connection_failure_title">A kapcsolódás sikertelen</string>
    <string name="mozac_browser_errorpages_content_crashed_message"><![CDATA[<p>A megtekinteni kívánt oldal nem jeleníthető meg, mert az adatátvitel közben hiba történt.</p><ul><li>Lépjen kapcsolatba a webhely üzemeltetőjével, és értesítse a problémáról.</li></ul>]]></string>
    <string name="mozac_browser_errorpages_content_crashed_title">A tartalom összeomlott</string>
    <string name="mozac_browser_errorpages_corrupted_content_message"><![CDATA[<p>A megtekinteni kívánt oldal nem jeleníthető meg, mert az adatátvitel közben hiba történt.</p><ul><li>Lépjen kapcsolatba a webhely üzemeltetőjével, és értesítse a problémáról.</li></ul>]]></string>
    <string name="mozac_browser_errorpages_corrupted_content_title">Sérült tartalom hiba</string>
    <string name="mozac_browser_errorpages_file_access_denied_message"><![CDATA[<ul>\n<li>Lehet hogy törölve lett, át lett helyezve, vagy a fájljogosultságok megakadályozzák a hozzáférést.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_access_denied_title">A fájl elérése megtagadva</string>
    <string name="mozac_browser_errorpages_file_not_found_message"><![CDATA[<ul>\n<li>Lehet, hogy a fájlt átnevezték, eltávolították vagy áthelyezték?</li>\n<li>Nincs elgépelés, kis- és nagybetű eltérés stb. a címben?</li>\n<li>Rendelkezik a megfelelő hozzáférési jogokkal a kért fájlhoz?</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_not_found_title">A fájl nem található</string>
    <string name="mozac_browser_errorpages_generic_message"><![CDATA[<p>Jelenleg nem áll rendelkezésre további információ a problémáról vagy hibáról.</p>]]></string>
    <string name="mozac_browser_errorpages_generic_title">A kérés nem teljesíthető</string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_message"><![CDATA[<p>A(z) %1$s címen található weboldal le lett tiltva, mert az egyik kiegészítője megpróbálta megnyitni. Ez a webhely felhasználható arra, hogy ellopják az információit – például a jelszavait vagy bankkártyaszámait.</p>]]></string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_title">A webhely az Ön biztonsága érdekében blokkolva</string>
    <string name="mozac_browser_errorpages_httpsonly_button">Tovább a HTTP oldalra</string>
    <string name="mozac_browser_errorpages_httpsonly_message"><![CDATA[Engedélyezte a Csak-HTTPS módot a fokozott biztonság érdekében, és a <em>%1$s</em> HTTPS verziója nem érhető el.]]></string>
    <string name="mozac_browser_errorpages_httpsonly_title">Biztonságos webhely nem érhető el</string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_message"><![CDATA[<p>A megtekinteni kívánt oldal nem jeleníthető meg, mert érvénytelen vagy nem támogatott tömörítési formátumot használ.</p>\n<ul>\n<li>Lépjen kapcsolatba a webhely üzemeltetőjével, és értesítse a problémáról.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_title">Tartalomkódolási hiba</string>
    <string name="mozac_browser_errorpages_malformed_uri_message"><![CDATA[<p>A megadott cím formátuma nem felismerhető. Ellenőrizze a címsorba beírtakat, javítsa a hibákat, és próbálja újra.</p>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_message_alternative"><![CDATA[<ul><li>A webcímek általában úgy néznek ki, mint a <strong>http://www.example.com/</strong></li><li>Győződjön meg róla, hogy perjeleket használ (tehát <strong>/</strong>).</li></ul>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_title">Érvénytelen cím</string>
    <string name="mozac_browser_errorpages_malformed_uri_title_alternative">A cím érvénytelen</string>
    <string name="mozac_browser_errorpages_net_interrupt_message"><![CDATA[<p>A böngésző sikeresen kapcsolódott, de a kapcsolat megszakadt az adatok átvitelekor. Próbálja újra.</p>\n<ul>\n<li>Az oldal ideiglenes nem érhető el, vagy túl elfoglalt. Próbálja újra néhány pillanat múlva.</li>\n<li>Ha egyetlen oldalt sem tud betölteni, akkor ellenőrizze az eszköz adat- vagy Wi-Fi kapcsolatát.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_interrupt_title">A kapcsolat megszakadt</string>
    <string name="mozac_browser_errorpages_net_reset_message"><![CDATA[<p>A hálózati kapcsolat megszakadt a kapcsolat újratárgyalásakor. Próbálja újra.</p>\n<ul>\n<li>Az oldal ideiglenes nem érhető el, vagy túl elfoglalt. Próbálja újra néhány pillanat múlva.</li>\n<li>Ha egyetlen oldalt sem tud betölteni, akkor ellenőrizze az eszköz adat- vagy Wi-Fi kapcsolatát.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_reset_title">A kapcsolat alaphelyzetbe állt</string>
    <string name="mozac_browser_errorpages_net_timeout_message"><![CDATA[<p>A kért webhely nem válaszolt a kapcsolatkezdeményezésre, és a böngésző beszüntette a várakozást a válaszra.</p><ul><li>Lehet, hogy a kiszolgáló túl sok lekérést kap, vagy ideiglenesen üzemen kívül van? Próbálja újra később.</li><li>Más webhelyeket sem képes elérni? Ellenőrizze a számítógép hálózati kapcsolatát.</li><li>Lehetséges, hogy tűzfal vagy proxy mögött van a számítógépe vagy a helyi hálózata? A helytelen beállítások zavarhatják a webböngészést.</li><li>Továbbra is fennáll a probléma? Kérjen segítséget a rendszergazdától vagy az internetszolgáltatójától.</li></ul>]]></string>
    <string name="mozac_browser_errorpages_net_timeout_title">A kapcsolat időtúllépés miatt megszakadt</string>
    <string name="mozac_browser_errorpages_no_internet_error_code">Hibakód: NS_ERROR_OFFLINE</string>
    <string name="mozac_browser_errorpages_no_internet_message_2">Próbáljon meg csatlakozni egy másik eszközről. Ellenőrizze a modemet vagy útválasztót. Bontsa a kapcsolatot, majd csatlakozzon újra a Wi-Fi-hez.</string>
    <string name="mozac_browser_errorpages_no_internet_refresh_button">Újratöltés</string>
    <string name="mozac_browser_errorpages_no_internet_title_2">Úgy néz ki, hogy probléma van az internetkapcsolatával</string>
    <string name="mozac_browser_errorpages_offline_message"><![CDATA[<p>A böngésző kapcsolat nélküli módban van, ezért nem tud csatlakozni a kért elemhez.</p>\n<ul>\n<li>Csatlakoztatva van a számítógép a hálózathoz?</li>\n<li>Nyomja meg a „Próbálja újra” gombot az online módba váltáshoz és az oldal újratöltéséhez.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_offline_title">Kapcsolat nélküli mód</string>
    <string name="mozac_browser_errorpages_page_refresh">Próbálja újra</string>
    <string name="mozac_browser_errorpages_port_blocked_message"><![CDATA[<p>A kért cím olyan portot adott meg (pl. <q>mozilla.org:80</q> a mozilla.org 80-as portjához), amelyet általában <em>nem</em> szokás webböngészés céljaira használni. A böngésző nem engedélyezi ezt a lekérést az Ön védelme és biztonsága érdekében.</p>]]></string>
    <string name="mozac_browser_errorpages_port_blocked_title">A port biztonsági okok miatt tiltva van</string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_message"><![CDATA[<p>A böngésző proxykiszolgáló használatára van beállítva, de a proxy visszautasította a kapcsolatot.</p>\n<ul>\n<li>Jók a böngésző proxybeállításai? Ellenőrizze a beállításokat, és próbálja újra.</li>\n<li>A proxyszolgáltatás engedélyezi a kapcsolatokat erről a hálózatról?</li>\n<li>Továbbra is fennáll a probléma? Kérjen segítséget a rendszergazdától vagy az internetszolgáltatójától.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_title">A proxykiszolgáló visszautasította a kapcsolatot</string>
    <string name="mozac_browser_errorpages_redirect_loop_message"><![CDATA[<p>A böngésző megszakította a kért elem lekérésére irányuló kísérleteket. A webhely oly módon irányította át a kérést, hogy az sosem teljesülhet.</p>\n<ul>\n<li>Letiltotta a webhely által megkövetelt sütiket?</li>\n<li>Ha a webhely sütijeinek elfogadása nem oldja meg a problémát, valószínűleg a kiszolgáló beállításában van a hiba, nem az Ön számítógépében.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_redirect_loop_title">Az oldal nem megfelelően van átirányítva</string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_message"><![CDATA[<p>A(z) %1$s címen működő webhelyről bejelentés érkezett, hogy támadó webhely, ezért a biztonsági beállítások alapján a böngésző a hozzáférést nem engedélyezi.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_title">Kártékony szoftvert terjesztő webhely probléma</string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_message"><![CDATA[<p>A(z) %1$s címen működő webhelyről bejelentés érkezett, hogy nem kívánatos szoftvereket szolgál ki, ezért a biztonsági beállítások alapján a böngésző a hozzáférést nem engedélyezi.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_title">Nem kívánt webhely miatti probléma</string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_message"><![CDATA[<p>A(z) %1$s címen működő webhelyről bejelentés érkezett, hogy ártalmas webhely lehet, ezért a biztonsági beállítások alapján a böngésző a hozzáférést nem engedélyezi.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_title">Káros webhely probléma</string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_message"><![CDATA[<p>A(z) %1$s címen működő webhelyről bejelentés érkezett, hogy félrevezető webhely, ezért a biztonsági beállítások alapján a böngésző a hozzáférést nem engedélyezi.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_title">Félrevezető oldal probléma</string>
    <string name="mozac_browser_errorpages_security_bad_cert_accept_temporary">Kockázat elfogadása és továbblépés</string>
    <string name="mozac_browser_errorpages_security_bad_cert_advanced">Speciális…</string>
    <string name="mozac_browser_errorpages_security_bad_cert_back">Visszalépés (ajánlott)</string>
    <string name="mozac_browser_errorpages_security_bad_cert_message"><![CDATA[<ul><li>Ezt okozhatja a kiszolgáló nem megfelelő beállítása, de az is lehet, hogy valaki megpróbál a kiszolgáló nevében fellépni.</li><li>Ha korábban már sikeresen kapcsolódott ehhez a kiszolgálóhoz, akkor lehet, hogy a hiba csak ideiglenes, és később újra próbálkozhat.</li></ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_techInfo"><![CDATA[<label>Lehet, hogy valaki megpróbálja megszemélyesíteni az oldalt, így nem kellene folytatnia.</label> <br><br>\n<label>A weboldalak tanúsítványok segítségével bizonyítják a személyazonosságukat. A %1$s nem bízik a(z) <b>%2$s</b> oldalban, mert a tanúsítvány kibocsátója ismeretlen, a tanúsítvány önaláírt, vagy a kiszolgáló nem küldi el a helyes közbülső tanúsítványokat.</label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_title">A biztonságos kapcsolat sikertelen</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_advanced">Speciális…</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_back">Ugrás vissza</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_message"><![CDATA[<ul>\n<li>A megtekintendő oldal nem jeleníthető meg, mert ez a webhely biztonságos kapcsolatot igényel.</li>\n<li>A probléma nagy valószínűséggel a webhelyen van, és nem tud mit tenni a megoldása érdekében.</li>\n<li>A problémáról értesítheti a webhely rendszergazdáját.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_techInfo2"><![CDATA[<label>A(z) <b>%1$s</b> oldal a HTTP Strict Transport Security (HSTS) nevű biztonsági házirendet használja, amely azt jelenti, hogy a(z) <b>%2$s</b> csak biztonságosan kapcsolódhat hozzá. Nem adhat hozzá kivételt, hogy felkeresse ezt az oldalt. </label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_title">Ez a webhely biztonságos kapcsolatot igényel.</string>
    <string name="mozac_browser_errorpages_security_ssl_message"><![CDATA[<ul><li>A megtekinteni kívánt oldal nem jeleníthető meg, mert a kapott adatok hitelessége nem ellenőrizhető.</li>\n<li>Lépjen kapcsolatba a webhely üzemeltetőjével, és értesítse a problémáról.</li></ul>]]></string>
    <string name="mozac_browser_errorpages_security_ssl_title">A biztonságos kapcsolat sikertelen</string>
    <string name="mozac_browser_errorpages_unknown_host_message"><![CDATA[<p>A böngésző nem találta a megadott címhez tartozó gazdakiszolgálót.</p>\n<ul>\n<li>Ellenőrizze, hogy nincsenek elírások a címben, például <strong>ww</strong>.example.com a <strong>www</strong>.example.com helyett.</li>\n<li>Ha egyetlen oldalt sem tud betölteni, akkor ellenőrizze az eszköz adat- vagy Wi-Fi kapcsolatát.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_host_title">Cím nem található</string>
    <string name="mozac_browser_errorpages_unknown_protocol_message"><![CDATA[<p>A cím meghatározott egy protokollt (például <q>wxyz://</q>), amelyet a böngésző nem ismer fel, ezért nem képes megfelelően csatlakozni a webhelyhez.</p>\n<ul>\n<li>Multimédiás vagy más, nem szöveges szolgáltatást szeretne elérni? Nézze meg a webhelyet, milyen további követelményeket támaszt.</li>\n<li>Bizonyos protokollok harmadik féltől származó szoftverek vagy bővítmények meglétét követelik meg, a böngésző csak ezek megléte esetén ismeri fel az adott protokollt.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_protocol_title">Ismeretlen protokoll</string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_message"><![CDATA[<p>A böngésző proxykiszolgáló használatára van beállítva, de a proxy nem található.</p>\n<ul>\n<li>Jók a böngésző proxybeállításai? Ellenőrizze a beállításokat, és próbálja újra.</li>\n<li>Csatlakoztatva van a számítógép a hálózathoz?</li>\n<li>Továbbra is fennáll a probléma? Kérjen segítséget a rendszergazdától vagy az internetszolgáltatójától.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_title">Proxykiszolgáló nem található</string>
    <string name="mozac_browser_errorpages_unknown_socket_type_message"><![CDATA[<p>A webhely a hálózati kérésre váratlan módon válaszolt, ezért a böngésző nem tudja folytatni a párbeszédet.</p>]]></string>
    <string name="mozac_browser_errorpages_unknown_socket_type_title">Váratlan válasz a kiszolgálótól</string>
    <string name="mozac_browser_errorpages_unsafe_content_type_message"><![CDATA[<ul><li>Értesítse a webhely tulajdonosait erről a problémáról.</li></ul>]]></string>
