    <string name="mozac_browser_engine_system_alert_title">Η σελίδα στο %1$s δηλώνει:</string>
    <string name="mozac_browser_engine_system_auth_message">Το %2$s ζητά όνομα χρήστη και κωδικό πρόσβασής. Ο ιστότοπος δηλώνει: «%1$s»</string>
    <string name="mozac_browser_engine_system_auth_no_realm_message">Το %1$s ζητά το όνομα χρήστη και τον κωδικό πρόσβασής σας.</string>
    <string name="mozac_browser_errorpages_connection_failure_message"><![CDATA[<ul>\n<li>Η σελίδα ενδέχεται να είναι προσωρινά μη διαθέσιμη ή πολύ απασχολημένη. Δοκιμάστε ξανά σε λίγο.</li>\n<li>Αν δεν μπορείτε να φορτώσετε καμία σελίδα, ελέγξτε τη σύνδεση δεδομένων ή Wi-Fi σας.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_connection_failure_title">Δεν είναι δυνατή η σύνδεση</string>
    <string name="mozac_browser_errorpages_content_crashed_message"><![CDATA[<p>Δεν είναι δυνατή η εμφάνιση της σελίδας που προσπαθείτε να προβάλετε λόγω σφάλματος κατά τη μεταφορά των δεδομένων.</p>\n<ul>\n<li>Επικοινωνήστε με τους ιδιοκτήτες του ιστοτόπου για να τους ενημερώσετε σχετικά με αυτό το πρόβλημα.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_content_crashed_title">Το περιεχόμενο καταστράφηκε</string>
    <string name="mozac_browser_errorpages_corrupted_content_message"><![CDATA[<p>Δεν είναι δυνατή η εμφάνιση της σελίδας που προσπαθείτε να προβάλετε λόγω σφάλματος κατά τη μεταφορά των δεδομένων.</p>\n<ul>\n<li>Επικοινωνήστε με τους ιδιοκτήτες του ιστοτόπου για να τους ενημερώσετε σχετικά με αυτό το πρόβλημα.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_corrupted_content_title">Σφάλμα κατεστραμμένου περιεχομένου</string>
    <string name="mozac_browser_errorpages_file_access_denied_message"><![CDATA[<ul>\n<li>Ίσως έχει αφαιρεθεί, μετακινηθεί ή τα δικαιώματα αρχείου εμποδίζουν την πρόσβαση.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_access_denied_title">Άρνηση πρόσβασης στο αρχείο</string>
    <string name="mozac_browser_errorpages_file_not_found_message"><![CDATA[<ul>\n<li>Μήπως το στοιχείο έχει μετονομαστεί, αφαιρεθεί, ή μετακινηθεί;</li>\n<li>Υπάρχουν σφάλματα ορθογραφίας, κεφαλαίων, ή άλλα τυπογραφικά λάθη στη διεύθυνση;</li>\n<li>Έχετε επαρκή δικαιώματα για πρόσβαση στο ζητούμενο στοιχείο;</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_not_found_title">Το αρχείο δεν βρέθηκε</string>
    <string name="mozac_browser_errorpages_generic_message"><![CDATA[<p>Δεν υπάρχουν προς το παρόν επιπρόσθετες πληροφορίες σχετικά με αυτό το πρόβλημα ή σφάλμα.</p>]]></string>
    <string name="mozac_browser_errorpages_generic_title">Δεν είναι δυνατή η ολοκλήρωση του αιτήματος</string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_message"><![CDATA[<p>Η ιστοσελίδα στο %1$s έχει αποκλειστεί επειδή ένα από τα πρόσθετά σας προσπάθησε να την ανοίξει. Αυτός ο ιστότοπος θα μπορούσε να χρησιμοποιηθεί για την κλοπή πληροφοριών σας, όπως κωδικούς πρόσβασης ή αριθμούς πιστωτικών καρτών.</p>]]></string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_title">Για λόγους ασφαλείας ο ιστότοπος αποκλείστηκε</string>
    <string name="mozac_browser_errorpages_httpsonly_button">Συνέχεια σε ιστότοπο HTTP</string>
    <string name="mozac_browser_errorpages_httpsonly_message"><![CDATA[Έχετε ενεργοποιήσει τη λειτουργία «Μόνο HTTPS» για ενισχυμένη ασφάλεια, αλλά δεν διατίθεται ασφαλής έκδοση HTTPS του <em>%1$s</em>.]]></string>
    <string name="mozac_browser_errorpages_httpsonly_title">Δεν διατίθεται ασφαλής ιστότοπος</string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_message"><![CDATA[<p>Δεν είναι δυνατή η εμφάνιση της σελίδας που προσπαθείτε να προβάλετε επειδή δεν χρησιμοποιεί έγκυρη ή υποστηριζόμενη μορφή συμπίεσης.</p>\n<ul>\n<li>Επικοινωνήστε με τους ιδιοκτήτες του ιστοτόπου για να τους ενημερώσετε σχετικά με αυτό το πρόβλημα.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_title">Σφάλμα κωδικοποίησης περιεχομένου</string>
    <string name="mozac_browser_errorpages_malformed_uri_message"><![CDATA[<p>Η μορφή της διεύθυνση δεν αναγνωρίζεται. Ελέγξτε τη γραμμή διευθύνσεων για λάθη και δοκιμάστε ξανά.</p>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_message_alternative"><![CDATA[<ul>\n<li>Οι διευθύνσεις ιστού γράφονται συνήθως ως εξής: <strong>http://www.example.com/</strong></li>\n<li>Βεβαιωθείτε ότι χρησιμοποιείτε τις σωστές καθέτους (δηλ. <strong>/</strong>).</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_title">Μη έγκυρη διεύθυνση</string>
    <string name="mozac_browser_errorpages_malformed_uri_title_alternative">Η διεύθυνση δεν είναι έγκυρη</string>
    <string name="mozac_browser_errorpages_net_interrupt_message"><![CDATA[<p>Το πρόγραμμα περιήγησης συνδέθηκε με επιτυχία, αλλά η σύνδεση διακόπηκε κατά τη μεταφορά πληροφοριών. Δοκιμάστε ξανά.</p>\n<ul>\n<li>Ο ιστότοπος ενδέχεται να είναι προσωρινά μη διαθέσιμος ή πολύ απασχολημένος. Δοκιμάστε ξανά σε λίγο.</li>\n<li>Aν δεν μπορείτε να φορτώσετε καμία σελίδα, ελέγξτε τη σύνδεση δεδομένων ή Wi-Fi της συσκευής σας.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_interrupt_title">Η σύνδεση διακόπηκε</string>
    <string name="mozac_browser_errorpages_net_reset_message"><![CDATA[<p>Η σύνδεση δικτύου διακόπηκε κατά τη διαδικασία σύνδεσης με τον ιστότοπο. Δοκιμάστε ξανά.</p>\n<ul>\n<li>Ο ιστότοπος ενδέχεται να είναι προσωρινά μη διαθέσιμος ή πολύ απασχολημένος. Δοκιμάστε ξανά σε λίγο.</li>\n<li>Αν δεν μπορείτε να φορτώσετε καμία σελίδα, ελέγξτε τη σύνδεση δεδομένων ή Wi-Fi της συσκευής σας.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_reset_title">Έγινε επαναφορά της σύνδεσης</string>
    <string name="mozac_browser_errorpages_net_timeout_message"><![CDATA[<p>Η ζητούμενη ιστοσελίδα δεν αποκρίθηκε στο αίτημα σύνδεσης και το πρόγραμμα περιήγησης σταμάτησε να περιμένει απάντηση.</p>\n<ul>\n<li>Μήπως ο διακομιστής αντιμετωπίζει υψηλή ζήτηση ή προσωρινή διακοπή λειτουργίας; Δοκιμάστε ξανά αργότερα.</li>\n<li>Δεν μπορείτε να περιηγηθείτε σε άλλες ιστοσελίδες; Ελέγξτε τη σύνδεση δικτύου της συσκευής σας.</li>\n<li>Προστατεύεται η συσκευή ή το δίκτυό σας από τείχος προστασίας ή διακομιστή μεσολάβησης; Οι εσφαλμένες ρυθμίσεις μπορούν να επηρεάσουν την περιήγηση.</li>\n<li>Έχετε ακόμη πρόβλημα; Συμβουλευτείτε τον διαχειριστή του δικτύου ή τον πάροχό σας για βοήθεια.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_timeout_title">Το χρονικό όριο της σύνδεσης έληξε</string>
    <string name="mozac_browser_errorpages_no_internet_error_code">Κωδικός σφάλματος: NS_ERROR_OFFLINE</string>
    <string name="mozac_browser_errorpages_no_internet_message_2">Δοκιμάστε να συνδεθείτε από διαφορετική συσκευή. Ελέγξτε το modem ή το router σας. Αποσυνδέστε και επανασυνδέστε το Wi-Fi.</string>
    <string name="mozac_browser_errorpages_no_internet_refresh_button">Ανανέωση</string>
    <string name="mozac_browser_errorpages_no_internet_title_2">Φαίνεται ότι υπάρχει κάποιο πρόβλημα με τη σύνδεσή σας στο διαδίκτυο</string>
    <string name="mozac_browser_errorpages_offline_message"><![CDATA[<p>Το πρόγραμμα περιήγησης είναι σε λειτουργία εκτός σύνδεσης και δεν μπορεί να συνδεθεί στο ζητούμενο στοιχείο.</p>\n<ul>\n<li>Είναι συνδεδεμένη η συσκευή σε ενεργό δίκτυο;</li>\n<li>Πατήστε «Δοκιμή ξανά» για σύνδεση στο διαδίκτυο και ανανέωση της σελίδας.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_offline_title">Λειτουργία εκτός σύνδεσης</string>
    <string name="mozac_browser_errorpages_page_refresh">Δοκιμή ξανά</string>
    <string name="mozac_browser_errorpages_port_blocked_message"><![CDATA[<p>Η ζητούμενη διεύθυνση καθόρισε θύρα (π.χ., <q>mozilla.org:80</q> για τη θύρα 80 στο mozilla.org) που <em>δεν</em> χρησιμοποιείται συνήθως για περιήγηση στο διαδίκτυο. Το πρόγραμμα περιήγησης ακύρωσε το αίτημα για να σας προστατεύσει.</p>]]></string>
    <string name="mozac_browser_errorpages_port_blocked_title">Περιορισμός θύρας για λόγους ασφαλείας</string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_message"><![CDATA[<p>Το πρόγραμμα περιήγησης έχει ρυθμιστεί ώστε να χρησιμοποιεί διακομιστή μεσολάβησης, αλλά ο διακομιστής μεσολάβησης αρνήθηκε τη σύνδεση.</p>\n<ul>\n<li>Έχει ρυθμιστεί σωστά ο διακομιστής μεσολάβησης; Ελέγξτε τις ρυθμίσεις και δοκιμάστε ξανά.</li>\n<li>Επιτρέπει ο διακομιστής μεσολάβησης συνδέσεις από αυτό το δίκτυο;</li>\n<li>Έχετε ακόμα πρόβλημα; Συμβουλευτείτε τον διαχειριστή του δικτύου σας ή τον πάροχό σας για βοήθεια.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_title">Άρνηση σύνδεσης διαμεσολαβητή</string>
    <string name="mozac_browser_errorpages_redirect_loop_message"><![CDATA[<p>Το πρόγραμμα περιήγησης έχει σταματήσει την προσπάθεια ανάκτησης του ζητούμενου στοιχείου. Η ιστοσελίδα ανακατευθύνει το αίτημα με τρόπο που δεν θα ολοκληρωθεί.</p>\n<ul>\n<li>Έχετε απενεργοποιήσει ή αποκλείσει τα cookie που απαιτούνται από την ιστοσελίδα;</li>\n<li>Αν η αποδοχή των cookie δεν επιλύει το πρόβλημα, μάλλον οφείλεται σε ζήτημα ρύθμισης του διακομιστή και όχι στη συσκευή σας.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_redirect_loop_title">Η σελίδα δεν ανακατευθύνει σωστά</string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_message"><![CDATA[<p>Ο ιστότοπος στο %1$s έχει αναφερθεί ως ιστότοπος επιθέσεων και έχει αποκλειστεί βάσει των προτιμήσεων ασφαλείας σας.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_title">Ζήτημα κακόβουλου ιστοτόπου</string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_message"><![CDATA[<p>Ο ιστότοπος στο %1$s έχει αναφερθεί για διανομή ανεπιθύμητου λογισμικού και έχει αποκλειστεί βάσει των προτιμήσεων ασφαλείας σας.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_title">Ζήτημα ανεπιθύμητου ιστοτόπου</string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_message"><![CDATA[<p>Ο ιστότοπος στο %1$s έχει αναφερθεί ως δυνητικά επιβλαβής και έχει αποκλειστεί βάσει των προτιμήσεων ασφαλείας σας.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_title">Ζήτημα επιβλαβούς ιστοτόπου</string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_message"><![CDATA[<p>Η ιστοσελίδα στο %1$s έχει αναφερθεί ως παραπλανητικός ιστότοπος και έχει αποκλειστεί βάσει των προτιμήσεων ασφαλείας σας.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_title">Ζήτημα παραπλανητικού ιστοτόπου</string>
    <string name="mozac_browser_errorpages_security_bad_cert_accept_temporary">Αποδοχή κινδύνου και συνέχεια</string>
    <string name="mozac_browser_errorpages_security_bad_cert_advanced">Σύνθετα…</string>
    <string name="mozac_browser_errorpages_security_bad_cert_back">Επιστροφή (Προτείνεται)</string>
    <string name="mozac_browser_errorpages_security_bad_cert_message"><![CDATA[<ul>\n<li>Ενδέχεται να υπάρχει πρόβλημα με τη διαμόρφωση του διακομιστή ή κάποιος προσπαθεί να μιμηθεί τον διακομιστή.</li>\n<li>Αν είχατε συνδεθεί με επιτυχία σε αυτόν τον διακομιστή στο παρελθόν, το σφάλμα ενδέχεται να είναι προσωρινό και μπορείτε να δοκιμάσετε ξανά αργότερα.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_techInfo"><![CDATA[<label>Κάποιος ίσως προσπαθεί να μιμηθεί την ιστοσελίδα και δεν πρέπει να συνεχίσετε.</label> <br><br>\n<label>Οι ιστοσελίδες αποδεικνύουν την ταυτότητά τους με τα πιστοποιητικά. Το %1$s δεν εμπιστεύεται το <b>%2$s</b>, επειδή ο εκδότης του πιστοποιητικού του είναι άγνωστος, το πιστοποιητικό είναι αυτοϋπογεγραμμένο, ή ο διακομιστής δεν στέλνει τα σωστά ενδιάμεσα πιστοποιητικά.</label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_title">Αποτυχία ασφαλούς σύνδεσης</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_advanced">Σύνθετα…</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_back">Επιστροφή</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_message"><![CDATA[<ul>\n<li>Δεν είναι δυνατή η εμφάνιση της σελίδας που προσπαθείτε να προβάλετε, επειδή αυτός ο ιστότοπος απαιτεί ασφαλή σύνδεση.</li>\n<li>Το ζήτημα οφείλεται κατά πάσα πιθανότητα στον ιστότοπο και δεν μπορείτε να κάνετε τίποτα για να το επιλύσετε.</li>\n<li>Μπορείτε να ειδοποιήστε τον διαχειριστή του ιστοτόπου σχετικά με το πρόβλημα.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_techInfo2"><![CDATA[<label> Το <b>%1$s</b> διαθέτει μια πολιτική ασφαλείας, η οποία ονομάζεται «HTTP Strict Transport Security (HSTS)», που σημαίνει ότι το <b>%2$s</b> μπορεί να συνδεθεί μόνο με ασφάλεια σε αυτό. Δεν μπορείτε να προσθέσετε εξαίρεση για να επισκεφθείτε τον ιστότοπο αυτό. </label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_title">Αυτός ο ιστότοπος απαιτεί ασφαλή σύνδεση.</string>
    <string name="mozac_browser_errorpages_security_ssl_message"><![CDATA[<ul>\n<li>Δεν είναι δυνατή η εμφάνιση της σελίδας που προσπαθείτε να προβάλετε επειδή δεν ήταν δυνατή η επαλήθευση της αυθεντικότητας των δεδομένων που ελήφθησαν.</li>\n<li>Επικοινωνήστε με τους ιδιοκτήτες του ιστοτόπου για να τους ενημερώσετε σχετικά με αυτό το πρόβλημα.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_ssl_title">Αποτυχία ασφαλούς σύνδεσης</string>
    <string name="mozac_browser_errorpages_unknown_host_message"><![CDATA[<p>Το πρόγραμμα περιήγησης δεν βρήκε τον κεντρικό διακομιστή για την παρεχόμενη διεύθυνση.</p>\n<ul>\n<li>Ελέγξτε τη διεύθυνση για τυχόν λάθη, όπως <strong>ww</strong>.example.com αντί για <strong>www</strong>.example.com.</li>\n<li>Αν δεν μπορείτε να φορτώσετε καμία σελίδα, ελέγξτε τα δεδομένα ή τη σύνδεση Wi-Fi της συσκευής σας.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_host_title">Η διεύθυνση δεν βρέθηκε</string>
    <string name="mozac_browser_errorpages_unknown_protocol_message"><![CDATA[<p>Η διεύθυνση καθορίζει ένα πρωτόκολλο (π.χ. «wxyz://») που δεν αναγνωρίζει το πρόγραμμα περιήγησης, επομένως δεν είναι δυνατή η σωστή σύνδεση στον ιστότοπο.</p>\n<ul>\n<li>Προσπαθείτε να προσπελάσετε πολυμέσα ή άλλες υπηρεσίες χωρίς κείμενο; Ελέγξτε τον ιστότοπο για επιπλέον απαιτήσεις.</li>\n<li>Ορισμένα πρωτόκολλα ενδέχεται να απαιτούν λογισμικό ή αρθρώματα τρίτων πριν μπορέσουν να αναγνωριστούν από το πρόγραμμα περιήγησης.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_protocol_title">Άγνωστο πρωτόκολλο</string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_message"><![CDATA[<p>Το πρόγραμμα περιήγησης έχει ρυθμιστεί ώστε να χρησιμοποιεί διακομιστή μεσολάβησης, αλλά δεν βρέθηκε διακομιστής μεσολάβησης.</p>\n<ul>\n<li>Έχει ρυθμιστεί σωστά ο διακομιστής μεσολάβησης; Ελέγξτε τις ρυθμίσεις και δοκιμάστε ξανά.</li>\n<li>Είναι συνδεδεμένη η συσκευή σε ενεργό δίκτυο;</li>\n<li>Έχετε ακόμη πρόβλημα; Συμβουλευτείτε τον διαχειριστή του δικτύου σας ή τον πάροχό σας για βοήθεια.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_title">Δεν βρέθηκε διακομιστής μεσολάβησης</string>
    <string name="mozac_browser_errorpages_unknown_socket_type_message"><![CDATA[<p>Ο ιστότοπος απάντησε με απρόσμενο τρόπο στο αίτημα δικτύου και το πρόγραμμα περιήγησης δεν μπορεί να συνεχίσει.</p>]]></string>
    <string name="mozac_browser_errorpages_unknown_socket_type_title">Απρόσμενη απάντηση από τον διακομιστή</string>
    <string name="mozac_browser_errorpages_unsafe_content_type_message"><![CDATA[<ul>\n<li>Επικοινωνήστε με τους ιδιοκτήτες του ιστοτόπου για να τους ενημερώσετε σχετικά με αυτό το πρόβλημα.</li>\n</ul>]]></string>
