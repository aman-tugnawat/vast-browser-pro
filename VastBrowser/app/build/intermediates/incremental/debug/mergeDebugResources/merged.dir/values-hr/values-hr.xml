    <string name="mozac_browser_engine_system_auth_message">%2$s zahtijeva korisničko ime i lozinku. Stranica vraća odgovor: “%1$s”</string>
    <string name="mozac_browser_engine_system_auth_no_realm_message">%1$s zahtijeva tvoje korisničko ime i lozinku.</string>
    <string name="mozac_browser_errorpages_connection_failure_message"><![CDATA[<ul>\n<li>Stranica je možda privremeno nedostupna ili preopterećena. Pokušaj ponovno malo kasnije.</li>\n<li>Ako ne možeš učitati niti jednu stranicu, provjeri podatke svog uređaja ili Wi-Fi vezu.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_connection_failure_title">Povezivanje nije moguće</string>
    <string name="mozac_browser_errorpages_content_crashed_message"><![CDATA[<p>Stranicu kojoj pokušavaš pristupiti nije moguće prikazati zbog greške u prijenosu podataka.</p>\n<ul>\n<li>Obavijesti vlasnike web stranice o ovom problemu.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_content_crashed_title">Greška u sadržaju</string>
    <string name="mozac_browser_errorpages_corrupted_content_message"><![CDATA[<p>Stranicu kojoj pokušavaš pristupiti nije moguće prikazati zbog greške u prijenosu podataka.</p>\n<ul>\n<li>Obavijesti vlasnike web stranice o ovom problemu.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_corrupted_content_title">Greška oštećenog sadržaja</string>
    <string name="mozac_browser_errorpages_file_access_denied_message"><![CDATA[<ul>\n<li>Možda je uklonjena, premještena ili dozvole za datoteku spriječavaju pristup.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_access_denied_title">Pristup datoteci je odbijen</string>
    <string name="mozac_browser_errorpages_file_not_found_message"><![CDATA[<ul>\n<li>Možda je uklonjena, premještena ili joj je ime promijenjeno?</li>\n<li>Postoji li pravopisna ili nekakva tipografska greška?</li>\n<li>Imaš li dovoljna prava za pristup traženoj datoteci?</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_not_found_title">Datoteka nije pronađena</string>
    <string name="mozac_browser_errorpages_generic_message"><![CDATA[<p>Dodatne informacije o ovom problemu ili grešci trenutno nisu dostupne.</p>]]></string>
    <string name="mozac_browser_errorpages_generic_title">Nije moguće dovršiti zahtjev</string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_message"><![CDATA[<p>Ova web stranica na %1$s je blokirana jer ju je pokušao otvoriti jedan od tvojih dodataka. Ova bi se stranica mogla koristiti za krađu tvojih podataka – poput lozinki ili brojeva kreditnih kartica.</p>]]></string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_title">Web-stranica je blokirana radi tvoje sigurnosti</string>
    <string name="mozac_browser_errorpages_httpsonly_button">Nastavi na stranicu preko HTTP-a</string>
    <string name="mozac_browser_errorpages_httpsonly_message"><![CDATA[Omogućen je \"samo HTTPS\" način rada za poboljšanu sigurnost, a HTTPS inačica stranice <em>%1$s</em> nije dostupna.]]></string>
    <string name="mozac_browser_errorpages_httpsonly_title">Sigurna stranica nije dostupna</string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_message"><![CDATA[<p>Stranica koju pokušavaš vidjeti ne može biti prikazana jer koristi neispravni ili nepodržani oblik komprimiranja.</p>\n<ul>\n<li>Kontaktiraj vlasnike web stranice i obavijesti ih o ovom problemu.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_title">Greška u kodiranju sadržaja</string>
    <string name="mozac_browser_errorpages_malformed_uri_message"><![CDATA[<p>Upisana adresa nije u prepoznatljivom obliku. Provjeri postoji li greška u unosu u adresnoj traci.</p>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_message_alternative"><![CDATA[<ul>\n<li>Adrese web stranica se obično pišu u formatu poput <strong>http://www.example.com/</strong></li>\n<li>Pazi na način pisanja kose crte (tj. <strong>/</strong>).</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_title">Neispravna adresa</string>
    <string name="mozac_browser_errorpages_malformed_uri_title_alternative">Adresa nije ispravna</string>
    <string name="mozac_browser_errorpages_net_interrupt_message"><![CDATA[<p>Preglednik se uspješno povezao, ali veza je prekinuta tijekom prijenosa informacija. Pokušaj ponovo.</p>\n<ul>\n<li>Stranica je možda privremeno nedostupna ili prezauzeta. Pokušaj ponovo za nekoliko trenutaka.</li>\n<li>Ako ne možeš učitati nijednu stranicu, provjeri podatke tvog uređaja ili Wi-Fi vezu.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_interrupt_title">Veza je prekinuta</string>
    <string name="mozac_browser_errorpages_net_reset_message"><![CDATA[<p>Mrežna veza je prekinuta tijekom povezivanja. Pokušaj ponovo.</p>\n<ul>\n<li>Stranica je možda privremeno nedostupna ili prezauzeta. Pokušaj ponovo za nekoliko trenutaka.</li>\n<li>Ako ne možeš učitati nijednu stranicu, provjeri podatke tvog uređaja ili Wi-Fi vezu.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_reset_title">Veza je prekinuta</string>
    <string name="mozac_browser_errorpages_net_timeout_message"><![CDATA[<p>Zatražena stranica nije odgovorila na zahtjev i preglednik je prestao čekati na odgovor.</p>\n<ul>\n<li>Možda je poslužitelj opterećen velikom količinom zahtjeva ili je privremeno ostao bez napajanja? Pokušaj ponovo kasnije.</li>\n<li>Možeš li pregledavati ostale stranice? Provjeri mrežnu vezu svog računala.</li>\n<li>Jesu li tvoje računalo ili mreža zaštićeni vatrozidom ili proxyjem? Neispravne postavke mogu prouzročiti probleme prilikom pregledavanja weba.</li>\n<li>Ukoliko još uvijek imaš probleme, za pomoć se obrati administratoru mreže ili pružatelju internetske usluge.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_timeout_title">Vezi je isteklo vrijeme</string>
    <string name="mozac_browser_errorpages_no_internet_error_code">Kod greške: NS_ERROR_OFFLINE</string>
    <string name="mozac_browser_errorpages_no_internet_message_2">Pokušaj se povezati na jednom drugom uređaju. Provjeri modem ili router. Prekini vezu i ponovo se spoji na Wi-Fi.</string>
    <string name="mozac_browser_errorpages_no_internet_refresh_button">Učitaj ponovo</string>
    <string name="mozac_browser_errorpages_no_internet_title_2">Čini se da postoji problem s tvojom internetskom vezom</string>
    <string name="mozac_browser_errorpages_offline_message"><![CDATA[<p>Preglednik je u izvanmrežnom načinu rada i ne može se spojiti na traženu stavku.</p>\n<ul>\n<li>Je li uređaj spojen na aktivnu mrežu?</li>\n<li>Klikni na „Pokušaj ponovo” za prebacivanje na mrežni način rada i ponovo učitaj stranicu.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_offline_title">Izvanmrežni način rada</string>
    <string name="mozac_browser_errorpages_page_refresh">Pokušaj ponovo</string>
    <string name="mozac_browser_errorpages_port_blocked_message"><![CDATA[<p>Zatražena adresa ima definiran priključak (npr. <q>mozilla.org:80</q> za priključak 80 na mozilla.org) koji se inače koristi za <em>druge</em> radnje, a ne za pregledavanje weba. Preglednik je prekinuo zahtjev radi tvoje zaštite i sigurnosti.</p>]]></string>
    <string name="mozac_browser_errorpages_port_blocked_title">Priključak je iz sigurnosnih razloga ograničen</string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_message"><![CDATA[<p>Preglednik je postavljen da koristi proxy poslužitelj, ali proxy poslužitelj odbija povezivanje.</p>\n<ul>\n<li>Jesu li proxy postavke ispravne? Provjeri postavke i pokušaj ponovo.</li>\n<li>Dozvoljava li proxy usluga povezivanje iz ove mreže?</li>\n<li>Ukoliko još uvijek imaš probleme, za pomoć se obrati administratoru mreže ili pružatelju internetske usluge.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_title">Proxy poslužitelj odbija povezivanje</string>
    <string name="mozac_browser_errorpages_redirect_loop_message"><![CDATA[<p>Preglednik je prestao dohvaćati zatražene stranice. Stranica preusmjerava zahtjev na takav način, da se on nikada ne može ispuniti.</p>\n<ul>\n<li>Jesu li kolačići za ovu stranicu deaktivirani ili blokirani?</li>\n<li>Ako prihvaćanje kolačića stranice ne riješi problem, vrlo vjerojatno se radi o problemu s konfiguracijom poslužitelja, a ne tvog računala.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_redirect_loop_title">Stranica ne preusmjerava ispravno</string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_message"><![CDATA[<p>Stranica na %1$s je prijavljena kao zloćudna stranica i blokirana je na temelju tvojih sigurnosnih postavki.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_title">Stranica sa zlonamjernim softverom</string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_message"><![CDATA[<p>Stranica na %1$s je prijavljena zbog posluživanja nepoželjnog softvera, te je blokirana na temelju tvojih sigurnosnih postavki.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_title">Neželjena stranica</string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_message"><![CDATA[<p>Web stranica %1$s je prijavljena kao potencijalno zlonamjerna stranica i blokirana je na temelju tvojih sigurnosnih postavki.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_title">Štetna stranica</string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_message"><![CDATA[<p>Web stranica %1$s je prijavljena kao obmanjujuća stranica i blokirana je na temelju tvojih sigurnosnih postavki.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_title">Problem s obmanjujućom stranicom</string>
    <string name="mozac_browser_errorpages_security_bad_cert_accept_temporary">Prihvati rizik i nastavi</string>
    <string name="mozac_browser_errorpages_security_bad_cert_advanced">Napredno …</string>
    <string name="mozac_browser_errorpages_security_bad_cert_back">Idi natrag (preporučeno)</string>
    <string name="mozac_browser_errorpages_security_bad_cert_message"><![CDATA[<ul>\n<li>Možda se radi o problemu s postavkama na serveru ili možda netko pokušava oponašati ovaj server.</li>\n<li>Ako u prošlosti nije bilo problema sa spajanjem na ovaj server, moguće je da se radi o privremenoj grešci, stoga pokušaj ponovo kasnije.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_techInfo"><![CDATA[<label>Netko možda pokušava lažno predstavljati web stranicu, stoga je bolje da ne nastaviš.</label> <br><br>\n<label> Web stranice dokazuju svoj identitet pomoću certifikata. %1$s ne vjeruje stranici na <b>%2$s</b>, jer je izdavač certifikata nepoznat, certifikat je samopotpisan ili poslužitelj ne šalje ispravne međucertifikate. </label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_title">Sigurna veza nije uspjela</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_advanced">Napredno…</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_back">Idi natrag</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_message"><![CDATA[<ul>\n<li>Stranica koju pokušavaš vidjeti se ne može prikazati zato što zahtijeva sigurnu vezu.</li>\n<li>Uzrok tome je najvjerojatnije sama web stranica i ne možeš ništa napraviti što bi riješilo problem.</li>\n<li>Možeš obavijestiti administratora web stranice o problemu.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_techInfo2"><![CDATA[<label> <b>%1$s</b> provodi sigurnosnu politiku pod nazivom HTTP Strict Transport Security (HSTS), koja znači da se <b>%2$s</b> može na istu povezati samo sigurno. Ne možete dodati iznimku za posjete ovoj web stranici. </label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_title">Ova web stranica zahtijeva sigurnu vezu.</string>
    <string name="mozac_browser_errorpages_security_ssl_message"><![CDATA[<ul>\n<li>Stranicu kojoj pokušavaš pristupiti nije moguće prikazati jer nije moguće provjeriti autentičnost primljenih podataka.</li>\n<li>Kontaktiraj vlasnike web stranice i obavijesti ih o ovom problemu.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_ssl_title">Sigurna veza nije uspjela</string>
    <string name="mozac_browser_errorpages_unknown_host_message"><![CDATA[<p>Preglednik nije mogao pronaći poslužitelja domaćina za navedenu adresu.</p>\n<ul>\n<li>Pazi da nemaš greške u tipkanju, kao što su <strong>ww</strong>.primjer.hr umjesto <strong>www</strong>.primjer.hr.</li>\n<li>Ako ne možeš učitati nijednu stranicu, provjeri podatke svog uređaja ili Wi-Fi vezu.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_host_title">Adresa nije pronađena</string>
    <string name="mozac_browser_errorpages_unknown_protocol_message"><![CDATA[<p>Adresa definira protkol (npr. <q>xyz://</q>) kojeg preglednik ne poznaje ili se ne može povezati sa zatraženom stranicom.</p>\n<ul>\n<li>Pokušavaš li pristupiti multimedijskim ili drugim netekstualnim uslugama? Provjeri ima li stranica dodatnih zahtjeva.</li>\n<li>Neki protokoli zahtijevaju program ili priključke treće strane, kako bi ih preglednik mogao prepoznati.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_protocol_title">Nepoznat protokol</string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_message"><![CDATA[<p>Preglednik je postavljen da koristi proxy poslužitelj, ali ga nije moguće naći.</p>\n<ul>\n<li>Jesu li proxy postavke ispravne? Provjeri postavke i pokušaj ponovo.</li>\n<li>Je li uređaj povezan na aktivnu mrežu?</li>\n<li>Ukoliko još uvijek imaš probleme, za pomoć se obrati administratoru mreže ili pružatelju internet usluge.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_title">Proxy poslužitelj nije pronađen</string>
    <string name="mozac_browser_errorpages_unknown_socket_type_message"><![CDATA[<p>Stranica je na mrežni zahtjev odgovorila na neočekivani način, zbog čega preglednik ne može nastaviti.</p>]]></string>
    <string name="mozac_browser_errorpages_unknown_socket_type_title">Neočekivani odgovor od poslužitelja</string>
    <string name="mozac_browser_errorpages_unsafe_content_type_message"><![CDATA[<ul>\n<li>Kontaktiraj vlasnike web stranice i obavijesti ih o ovom problemu.</li>\n</ul>]]></string>
