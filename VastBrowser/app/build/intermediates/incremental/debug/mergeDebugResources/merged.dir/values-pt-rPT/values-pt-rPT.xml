    <string name="mozac_browser_engine_system_alert_title">A página %1$s diz:</string>
    <string name="mozac_browser_engine_system_auth_message">%2$s está a solicitar o seu nome de utilizador e a palavra-passe. O site diz: “%1$s”</string>
    <string name="mozac_browser_engine_system_auth_no_realm_message">%1$s está a solicitar o seu nome de utilizador e a palavra-passe.</string>
    <string name="mozac_browser_errorpages_connection_failure_message"><![CDATA[<ul>\n<li>O site pode estar temporariamente indisponível ou demasiado ocupado. Volte a tentar dentro de alguns momentos.</li>\n<li>Se não conseguir carregar nenhuma página, verifique a ligação de dados ou de rede sem fios do dispositivo.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_connection_failure_title">Não é possível ligar</string>
    <string name="mozac_browser_errorpages_content_crashed_message"><![CDATA[<p>A página que está a tentar ver não pode ser apresentada porque foi detetado um erro na transmissão de dados.</p>\n<ul>\n<li>Por favor, contacte os proprietários do site para os informar deste problema.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_content_crashed_title">O conteúdo falhou</string>
    <string name="mozac_browser_errorpages_corrupted_content_message"><![CDATA[<p>A página que está a tentar ver não pode ser apresentada porque foi detetado um erro na transmissão de dados.</p>\n<ul>\n<li>Por favor, contacte os proprietários do site para os informar deste problema.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_corrupted_content_title">Erro de conteúdo corrompido</string>
    <string name="mozac_browser_errorpages_file_access_denied_message"><![CDATA[<ul>\n<li>Pode ter sido removido, movido ou as permissões do ficheiro podem estar a impedir o acesso.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_access_denied_title">O acesso ao ficheiro foi negado</string>
    <string name="mozac_browser_errorpages_file_not_found_message"><![CDATA[<ul>\n<li>O item pode ter sido renomeado, removido, ou movido?</li>\n<li>Existe algum erro ortográfico, de maiúsculas/minúsculas ou outro erro tipográfico no endereço?</li>\n<li>Tem permissões de acesso suficientes ao item solicitado?</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_not_found_title">Ficheiro não encontrado</string>
    <string name="mozac_browser_errorpages_generic_message"><![CDATA[<p>Neste momento, não está disponível informação adicional sobre este problema ou erro.</p>]]></string>
    <string name="mozac_browser_errorpages_generic_title">Não é possível concluir o pedido</string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_message"><![CDATA[<p>Esta página web em %1$s foi bloqueada porque um dos seus extras tentou abri-la. Este site pode ser utilizado para roubar a sua informação — tais como palavras-passe ou números de cartão de crédito.</p>]]></string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_title">Site bloqueado para sua segurança</string>
    <string name="mozac_browser_errorpages_httpsonly_button">Continuar para o site HTTP</string>
    <string name="mozac_browser_errorpages_httpsonly_message"><![CDATA[Ativou o modo Apenas HTTPS para uma maior segurança e não está disponível uma versão HTTPS de <em> %1$s </em>.]]></string>
    <string name="mozac_browser_errorpages_httpsonly_title">Site seguro não disponível</string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_message"><![CDATA[<p>A página que está a tentar ver não pode ser apresentada porque utiliza uma forma de compressão inválida ou não suportada.</p>\n<ul>\n<li>Por favor, contacte os proprietários do site para os informar deste problema.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_title">Erro de codificação de conteúdo</string>
    <string name="mozac_browser_errorpages_malformed_uri_message"><![CDATA[<p>O endereço fornecido não está num formato reconhecível. Por favor, verifique se a barra de endereço tem erros e tente novamente.</p>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_message_alternative"><![CDATA[<ul>\n<li>Os endereços de Internet são habitualmente escritos como <strong>http://www.example.com/</strong></li>\n<li>Verifique se está a utilizar barras (por exemplo, <strong>/</strong>).</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_title">Endereço inválido</string>
    <string name="mozac_browser_errorpages_malformed_uri_title_alternative">O endereço não é válido</string>
    <string name="mozac_browser_errorpages_net_interrupt_message"><![CDATA[<p>O navegador estabeleceu a ligação com sucesso, mas a ligação foi interrompida enquanto transferia informação. Por favor, tente novamente.</p>\n<ul>\n<li>O site pode estar temporariamente indisponível ou demasiado ocupado. Tente novamente dentro de alguns instantes.</li>\n<li>Se não consegue carregar quaisquer páginas, confirme a ligação de dados ou de rede sem fios.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_interrupt_title">A ligação foi interrompida</string>
    <string name="mozac_browser_errorpages_net_reset_message"><![CDATA[<p>A ligação de rede foi interrompida ao negociar uma ligação. Por favor, tente novamente.</p>\n<ul>\n<li>O site pode estar temporariamente indisponível ou demasiado ocupado. Tente novamente dentro de alguns instantes.</li>\n<li>Se não consegue carregar quaisquer páginas, confirme a ligação de dados ou de rede sem fios do seu dispositivo.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_reset_title">A ligação foi reposta</string>
    <string name="mozac_browser_errorpages_net_timeout_message"><![CDATA[<p>O site solicitado não respondeu ao pedido de ligação e o navegador deixou de esperar por uma resposta.</p>\n<ul>\n<li>O servidor poderá estar sobrecarregado ou temporariamente indisponível? Tente novamente mais tarde.</li>\n<li>Não consegue navegar noutros sites? Verifique a ligação do computador à rede.</li>\n<li>O seu computador ou rede estão protegidos por uma firewall ou proxy? Definições incorretas podem interferir com a navegação na Internet.</li>\n<li>Continua a ter problemas? Contacte o seu administrador de rede ou fornecedor de Internet para apoio.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_timeout_title">A ligação expirou</string>
    <string name="mozac_browser_errorpages_no_internet_error_code">Código de erro: NS_ERROR_OFFLINE</string>
    <string name="mozac_browser_errorpages_no_internet_message_2">Tente ligar-se num dispositivo diferente. Verifique o seu modem ou router. Desligue-se e volte a ligar-se ao Wi-Fi.</string>
    <string name="mozac_browser_errorpages_no_internet_refresh_button">Recarregar</string>
    <string name="mozac_browser_errorpages_no_internet_title_2">Parece que existe um problema com a sua ligação à Internet</string>
    <string name="mozac_browser_errorpages_offline_message"><![CDATA[<p>O navegador está a operar no modo desligado e não consegue estabelecer ligação ao objeto solicitado.</p>\n<ul>\n<li>O computador está ligado a uma rede ativa?</li>\n<li>Pressione \"Tentar novamente\" para mudar para o modo ligado e recarregar a página.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_offline_title">Modo desligado</string>
    <string name="mozac_browser_errorpages_page_refresh">Tentar novamente</string>
    <string name="mozac_browser_errorpages_port_blocked_message"><![CDATA[<p>O endereço solicitado especifica uma porta (por exemplo, <q>mozilla.org:80</q> para a porta 80 em mozilla.org) normalmente utilizada para <em>outros</em> fins para além de navegação na Internet. Para sua proteção e segurança o navegador cancelou o pedido.</p>]]></string>
    <string name="mozac_browser_errorpages_port_blocked_title">Porta restringida por questões de segurança</string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_message"><![CDATA[<p>O navegador está configurado para utilizar um servidor proxy, mas este recusou a ligação.</p>\n<ul>\n<li>A configuração de proxy do navegador está correta? Verifique as definições e tente novamente.</li>\n<li>O serviço de proxy permite ligações a partir desta rede?</li>\n<li>Continua a ter problemas? Consulte o seu administrador de rede ou fornecedor de Internet para apoio.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_title">O servidor proxy recusou a ligação</string>
    <string name="mozac_browser_errorpages_redirect_loop_message"><![CDATA[<p>O navegador deixou de tentar obter o item solicitado. O site está a redirecionar o pedido de modo a que este nunca seja concluído.</p>\n<ul>\n<li>Desativou ou bloqueou cookies que são necessárias para este site?</li>\n<li>Se aceitar os cookies do site não resolver o problema, é provável que seja um problema de configuração do servidor e não do seu computador.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_redirect_loop_title">A página não está a redirecionar corretamente</string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_message"><![CDATA[<p>O site em %1$s foi reportado como sendo um site de ataque e foi bloqueado com base nas suas preferências de segurança.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_title">Problema de software malicioso no site</string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_message"><![CDATA[<p>O site em %1$s foi reportado como sendo um site que fornece software não-solicitado e foi bloqueado com base nas suas preferências de segurança.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_title">Problema de site indesejado</string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_message"><![CDATA[<p>O site em %1$s foi reportado como sendo um site potencialmente nocivo e foi bloqueado com base nas suas preferências de segurança.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_title">Problema de site nocivo</string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_message"><![CDATA[<p>Esta página de Internet em %1$s foi reportada como sendo um site decetivo e foi bloqueada com base nas suas preferências de segurança.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_title">Problema de site decetivo</string>
    <string name="mozac_browser_errorpages_security_bad_cert_accept_temporary">Aceitar o risco e continuar</string>
    <string name="mozac_browser_errorpages_security_bad_cert_advanced">Avançado…</string>
    <string name="mozac_browser_errorpages_security_bad_cert_back">Retroceder (recomendado)</string>
    <string name="mozac_browser_errorpages_security_bad_cert_message"><![CDATA[<ul>\n<li>Isto pode dever-se a um problema de configuração do servidor, ou pode ser alguém a tentar usurpar a identidade do servidor.</li>\n<li>Se conseguiu ligar-se com sucesso a este servidor no passado, o erro poderá ser temporário e poderá tentar novamente mais tarde.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_techInfo"><![CDATA[<label>Alguém pode estar a tentar usurpar a identidade do site e não deve continuar.</label> <br><br>\n<label>Os sites comprovam a sua identidade via certificados. O %1$s não confia em <b>%2$s</b> porque o emissor do certificado é desconhecido, o certificado é auto-assinado ou o servidor não está a enviar os certificados intermédios corretos.</label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_title">A ligação segura falhou</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_advanced">Avançado…</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_back">Retroceder</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_message"><![CDATA[<ul>\n<li>A página que está a tentar visualizar não pode ser exibida porque este website precisa de uma ligação segura.</li>\n<li>O problema provavelmente está no website e não há nada que possa fazer para resolvê-lo.</li>\n<li>Pode notificar o administrador do website sobre o problema.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_techInfo2"><![CDATA[<label> <b>%1$s</b> tem uma política de segurança chamada HTTP Strict Transport Security (HSTS), que significa que o <b>%2$s</b> apenas pode ligar-se com este protocolo. Não é possível adicionar uma exceção para este site.</label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_title">Este website precisa de uma ligação segura.</string>
    <string name="mozac_browser_errorpages_security_ssl_message"><![CDATA[<ul>\n<li>A página que está a tentar ver não pode ser mostrada porque não foi possível verificar a autenticidade dos dados recebidos.</li>\n<li>Por favor, reporte o problema aos proprietários do site.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_ssl_title">A ligação segura falhou</string>
    <string name="mozac_browser_errorpages_unknown_host_message"><![CDATA[<p>O navegador não conseguiu encontrar o servidor anfitrião para o endereço fornecido.</p>\n<ul>\n<li>Verifique se o endereço não tem erros de escrita, tais como <strong>ww</strong>.example.com em vez de <strong>www</strong>.example.com.</li>\n<li>Se não consegue carregar quaisquer páginas, verifique a ligação de dados ou de rede sem fios do seu dispositivo.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_host_title">Endereço não encontrado</string>
    <string name="mozac_browser_errorpages_unknown_protocol_message"><![CDATA[<p>O endereço especifica um protocolo (por exemplo, <q>wxyz://</q>) que o navegador não reconhece, motivo pelo qual o navegador não consegue ligar-se corretamente ao site.</p>\n<ul>\n<li>Está a tentar aceder a recursos multimédia ou a outros serviços não baseados em texto? Verifique os requisitos adicionais do site.</li>\n<li>Alguns protocolos podem necessitar de software ou de plugins de terceiros para que o navegador os possa reconhecer.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_protocol_title">Protocolo desconhecido</string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_message"><![CDATA[<p>O navegador está configurado para utilizar um servidor proxy, mas este não foi encontrado.</p>\n<ul>\n<li>A configuração de proxy do navegador está correta? Verifique as definições e tente novamente.</li>\n<li>O computador está ligado a uma rede ativa?</li>\n<li>Continua a ter problemas? Consulte o seu administrador de rede ou fornecedor de Internet para apoio.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_title">Servidor proxy não encontrado</string>
    <string name="mozac_browser_errorpages_unknown_socket_type_message"><![CDATA[<p>O site respondeu ao pedido de rede de uma forma inesperada e o navegador não pode continuar.</p>]]></string>
    <string name="mozac_browser_errorpages_unknown_socket_type_title">Resposta inesperada do servidor</string>
    <string name="mozac_browser_errorpages_unsafe_content_type_message"><![CDATA[<ul>\n<li>Por favor, contacte os proprietários do site para os informar deste problema.</li>\n</ul>]]></string>
