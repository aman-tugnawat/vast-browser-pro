    <string name="mozac_browser_errorpages_security_bad_cert_back">തിരിച്ചു് (ശുപാൎശചെയ്തതു്)</string>
    <string name="mozac_browser_errorpages_security_bad_cert_message"><![CDATA[<ul>\n<li>ഇത്തിന്റെ കാരണം സെര്‍വറിന്റെ ക്രമീകരണത്തിലുള്ള പിശകോ അല്ലെങ്കില്‍ ആരെങ്കിലും ഈ സെര്‍വറാണെന്നു തെറ്റിദ്ധരിപ്പിയ്ക്കാന്‍ ശ്രമിയ്ക്കുന്നതോ ആണ്.</li>\n<li>നിങ്ങള്‍ ഇതിനു് മുമ്പു് ഈ സെര്‍വറിലേക്കു് വിജയകരമായി കണക്ട് ചെയ്തിട്ടുണ്ടെങ്കില്‍, ഇതു് വെറും ഒരു താല്‍ക്കാലിക പ്രശ്നമാവാം, അതുകൊണ്ടു് അല്പസമയം കഴിഞ്ഞ് ശ്രമിക്കുക.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_techInfo"><![CDATA[<label>ആരോ ആൾമാറാട്ടം നടത്താൻ ശ്രമിക്കുന്നതിനാൽ നിങ്ങൾ പോജിൽ തുടരരുത്.</label> <br><br>\n<label>വെബ്‌സൈറ്റുകൾ സർട്ടിഫിക്കറ്റുകൾ വഴി അവരുടെ ഐഡന്റിറ്റി തെളിയിക്കുന്നു. %1$s നെ<b>%2$s</b> വിശ്വസിയ്ക്കുന്നില്ല, കാരണം അതിന്റെ സർ‌ട്ടിഫിക്കറ്റ് നൽ‌കുന്നയാൾ‌ ഒന്നുകിൽ അജ്ഞാതനാണ് അല്ലെങ്കിൽ സർ‌ട്ടിഫിക്കറ്റ് സ്വയം ഒപ്പിട്ടതാണ്, അതുമല്ലെങ്കിൽ‌ സെർ‌വർ‌ ശരിയായ ഇന്റർ‌മീഡിയറ്റ് സർ‌ട്ടിഫിക്കറ്റുകൾ‌ അയയ്‌ക്കുന്നില്ല.</label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_title">സുരക്ഷിതമായ കണക്ഷന്‍ പരാജയപ്പെട്ടു</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_advanced">കൂടുതൽ…</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_back">തിരിച്ചു് പോവുക</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_message"><![CDATA[<ul>\n<li>താങ്ങൾ കാണാൻ ശ്രമിക്കുന്ന താൾ കാണിപ്പിക്കാൻ പറ്റത്തില്ല, കാരണം ഈ വെബ്സ്ഥാനത്തിനൊരു സുരക്ഷിതമായ സമ്പർക്കത്തിന്റെ ആവശ്യമുണ്ടു്.</li>\n<li>കുഴപ്പം മിക്കവാറും വെബ്സ്ഥാനത്തിലായിരിക്കും അതു് പരിഹരിക്കാനും താങ്ങൾക്കു് ഒന്നും ചെയ്യാൻ പറ്റില്ല</li>\n<li>താങ്ങൾക്കു് വേണമെങ്കിൽ ഈ വെബ്സ്ഥാനത്തിന്റെ അധികാരിയെ ഈ കുഴപ്പത്തെക്കുറിച്ചു് അറിയിക്കാം.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_techInfo2"><![CDATA[<label><b>%1$s</b>-നു് HTTP Strict Transport Security (HSTS) പേരുള്ള ഒരു സംരക്ഷണ നയമുണ്ടു്. ഇതുകൊണ്ടു് <b>%2$s</b>-നെ സുരക്ഷിത വഴിയിൽ മാത്രം ബന്ധപ്പെടാം. താങ്ങൾക്കു് ഈ വെബിടത്തിലോട്ടു് ചെല്ലാൻ വേണ്ടി ഒരു വിട്ടുവീഴ്ച ചേൎക്കാൻ പറ്റത്തില്ല.</label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_title">ഈ വെബ്സ്ഥാനത്തിനൊരു സുരക്ഷിതമായ സമ്പർക്കത്തിന്റെ ആവശ്യമുണ്ടു്.</string>
    <string name="mozac_browser_errorpages_security_ssl_message"><![CDATA[<ul>\n<li>ലഭ്യമായ ഡേറ്റയുടെ ആധികാരികത ഉറപ്പാക്കുവാന്‍ സാധ്യമാകാത്തതിനാൽ, നിങ്ങള്‍ കാണുവാന്‍ ശ്രമിക്കുന്ന താള്‍ ഇപ്പോള്‍ ലഭ്യമല്ല.</li>\n<li>ഇതു് സംബന്ധിച്ചുള്ള വിവരങ്ങള്‍ ദയവായി വെബ്‍സൈറ്റ് ഉടമസ്ഥരെ അറിയിക്കുക.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_ssl_title">സുരക്ഷിതമായ കണക്ഷന്‍ പരാജയപ്പെട്ടിരിക്കുന്നു</string>
    <string name="mozac_browser_errorpages_unknown_host_message"><![CDATA[<p>നൽകിയ വിലാസത്തിന്റെ ഹോസ്റ്റ് സെർവർ കണ്ടെത്താൻ ബ്രൗസറിന് കഴിഞ്ഞില്ല.</p>\n<ul>\n<li>താഴെ കാണിച്ചിട്ടുള്ളത് പോലുള്ള പിശകുകൾ വിലാസം നൽകുന്നതിൽ പറ്റിയിട്ടുണ്ടോയെന്ന് പരിശോധിക്കുക <strong> www </strong>.example.com എന്നതിന് പകരം <strong> ww</strong>.example.com.</li>\n<li>താങ്കൾക്ക് പേജുകളൊന്നും ലോഡുചെയ്യാൻ കഴിയുന്നില്ലെങ്കിൽ, താങ്കളുടെ ഉപകരണത്തിന്റെ ഡാറ്റയോ വൈഫൈ കണക്ഷനോ പരിശോധിക്കുക.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_host_title">വിലാസം ലഭ്യമായില്ല</string>
    <string name="mozac_browser_errorpages_unknown_protocol_message"><![CDATA[<p>വിലാസം നൽകിയ പ്രോട്ടോകോൾ (ഉദാ. <q>wxyz://</q>) ബ്രൗസറിനു് തിരിച്ചറിയുവാന്‍ സാധിക്കുന്നില്ല, ആയതിനാൽ ബ്രൗസറിന് സൈറ്റിലേക്ക് ശരിയായി ബന്ധിപ്പിക്കാനാവുന്നില്ല</p><ul><li>നിങ്ങള്‍ മള്‍ട്ടിമീഡിയയോ അതോ മറ്റേതെങ്കിലും ടെക്സ്റ്റല്ലാത്ത സേവനങ്ങളോ ലഭ്യമാക്കാനാണോ ശ്രമിക്കുന്നത്? കൂടുതല്‍ ആവശ്യങ്ങൾ എന്തെല്ലാം എന്നറിയുന്നതിനായി സൈറ്റ് പരിശോധിക്കുക.</li><li>ചില പ്രോട്ടോക്കോളുകള്‍ക്ക്, അവയെ ബ്രൗസറിന് തിരിച്ചറിയാനാവുന്നതിന് തേര്‍ഡ്-പാര്‍ട്ടി സോഫ്റ്റ്‌വെയര്‍ അല്ലെങ്കില്‍ പ്ലഗിനുകൾ ആവശ്യമുണ്ടാകാം.</li></ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_protocol_title">അപരിചിതമായ പെരുമാറ്റച്ചട്ടം</string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_message"><![CDATA[<p>ഒരു പ്രോക്സി സര്‍വര്‍ ഉപയോഗിക്കുന്നതിനായി ബ്രൗസറിനെ ക്രമീകരിച്ചിരിക്കുന്നു, പക്ഷേ പ്രോക്സി കണ്ടെത്താനായില്ല.</p><ul><li>ബ്രൗസറിന്റെ പ്രോക്സി ക്രമീകരണം ശരിയാണോ? അവ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക.</li><li>കംപ്യൂട്ടര്‍ സജീവമായ ഒരു ശൃംഘലയിലാണോ?</li><li>ഇപ്പോഴും പ്രശ്നം ഉണ്ടോ? എങ്കില്‍ ശൃംഘല കാര്യനിർവാഹകർ അല്ലെങ്കില്‍ ഇന്റര്‍നെറ്റ് ദേതാവുമായി ബന്ധപ്പെടുക.</li></ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_title">പ്രോക്സി സെർവർ കണ്ടെത്താനായില്ല</string>
    <string name="mozac_browser_errorpages_unknown_socket_type_message"><![CDATA[<p>നെറ്റ്‍വർക്കിൽ നിന്നും അപ്രതീക്ഷിതമായ പ്രതികരണമുണ്ടായി, അതിനാല്‍ ബ്രൗസറിനു് മുമ്പോട്ട് തുടരുവാന്‍ സാധ്യമാകുന്നില്ല.</p>]]></string>
    <string name="mozac_browser_errorpages_unknown_socket_type_title">സെര്‍വറില്‍ നിന്നും പ്രതീക്ഷിക്കാത്ത പ്രതികരണം</string>
