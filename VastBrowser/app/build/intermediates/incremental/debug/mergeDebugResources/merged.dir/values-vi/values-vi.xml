    <string name="mozac_browser_engine_system_alert_title">Trang %1$s cho biết:</string>
    <string name="mozac_browser_engine_system_auth_message">%2$s yêu cầu tên người dùng và mật khẩu của bạn. Trang web thông báo: “%1$s”</string>
    <string name="mozac_browser_engine_system_auth_no_realm_message">%1$s yêu cầu tên người dùng và mật khẩu của bạn.</string>
    <string name="mozac_browser_errorpages_connection_failure_message"><![CDATA[<ul>\n<li>Trang web có thể tạm thời không có hoặc quá tải. Hãy thử lại sau.</li>\n<li>Nếu bạn không thể tải bất kỳ trang nào, hãy kiểm tra kết nối dữ liệu hoặc kết nối Wi-Fi trên thiết bị của bạn.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_connection_failure_title">Không thể kết nối</string>
    <string name="mozac_browser_errorpages_content_crashed_message"><![CDATA[<p>Trang bạn đang cố truy cập không thể hiển thị vì đã phát hiện lỗi trong quá trình truyền dữ liệu.</p>\n<ul>\n<li>Vui lòng liên hệ với các chủ sở hữu trang web để thông báo cho họ về vấn đề này.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_content_crashed_title">Nội dung bị lỗi</string>
    <string name="mozac_browser_errorpages_corrupted_content_message"><![CDATA[<p>Trang bạn đang cố truy cập không thể được hiển thị vì đã phát hiện lỗi trong quá trình truyền dữ liệu.</p>\n<ul>\n<li>Vui lòng liên hệ với các chủ sở hữu trang web để thông báo cho họ về vấn đề này.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_corrupted_content_title">Lỗi nội dung bị hỏng</string>
    <string name="mozac_browser_errorpages_file_access_denied_message"><![CDATA[<ul>\n<li>Nó có thể đã được gỡ bỏ, di chuyển, hoặc quyền truy cập tập tin có thể đã bị từ chối.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_access_denied_title">Quyền truy cập tập tin đã bị từ chối</string>
    <string name="mozac_browser_errorpages_file_not_found_message"><![CDATA[<ul>\n<li>Mục này đã được đổi tên, loại bỏ hoặc di chuyển không?</li>\n<li>Có lỗi chính tả, viết hoa hoặc lỗi đánh máy khác trong địa chỉ không?</li>\n<li>Bạn có đủ quyền truy cập vào mục được yêu cầu không?</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_file_not_found_title">Không tìm thấy tập tin</string>
    <string name="mozac_browser_errorpages_generic_message"><![CDATA[<p>Hiện không có thông tin bổ sung về sự cố hay lỗi này.</p>]]></string>
    <string name="mozac_browser_errorpages_generic_title">Không thể hoàn tất yêu cầu</string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_message"><![CDATA[<p>Trang web này tại %1$s đã bị chặn vì một trong các tiện ích mở rộng của bạn đã cố gắng mở nó. Trang web này có thể được sử dụng để đánh cắp thông tin của bạn — chẳng hạn như mật khẩu hoặc số thẻ tín dụng.</p>]]></string>
    <string name="mozac_browser_errorpages_harmful_addon_uri_title">Trang web bị chặn để đảm bảo an toàn cho bạn</string>
    <string name="mozac_browser_errorpages_httpsonly_button">Tiếp tục đến trang web HTTP</string>
    <string name="mozac_browser_errorpages_httpsonly_message"><![CDATA[Bạn đã bật Chế độ chỉ HTTPS để tăng cường bảo mật, và phiên bản HTTPS của <em>%1$s</em> không khả dụng.]]></string>
    <string name="mozac_browser_errorpages_httpsonly_title">Trang web an toàn không khả dụng</string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_message"><![CDATA[<p>Trang bạn đang cố truy cập không thể hiển thị vì nó sử dụng hình thức nén không hợp lệ hoặc không được hỗ trợ.</p>\n<ul>\n<li> Vui lòng liên hệ với các chủ sở hữu trang web để thông báo cho họ về vấn đề này.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_invalid_content_encoding_title">Lỗi mã hóa nội dung</string>
    <string name="mozac_browser_errorpages_malformed_uri_message"><![CDATA[<p>Địa chỉ bạn cung cấp không đúng định dạng. Vui lòng kiểm tra lại thanh địa chỉ để tìm lỗi và thử lại.</p>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_message_alternative"><![CDATA[<ul>\n<li>Địa chỉ web thường được viết như <strong>http://www.example.com/</strong></li>\n<li>Đảm bảo rằng bạn sử dụng dấu gạch chéo về phía trước (như <strong>/</strong>).</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_malformed_uri_title">Địa chỉ không hợp lệ</string>
    <string name="mozac_browser_errorpages_malformed_uri_title_alternative">Địa chỉ không hợp lệ</string>
    <string name="mozac_browser_errorpages_net_interrupt_message"><![CDATA[<p>Trình duyệt đã kết nối thành công, nhưng kết nối bị gián đoạn trong khi truyền thông tin. Vui lòng thử lại.</p>\n<ul>\n<li>Trang web có thể tạm thời không khả dụng hoặc quá tải. Hãy đợi một lúc và thử lại sau.</li>\n<li>Nếu bạn không thể tải bất kỳ trang nào, hãy kiểm tra kết nối dữ liệu hoặc kết nối Wi-Fi trên thiết bị của bạn.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_interrupt_title">Kết nối đã bị gián đoạn</string>
    <string name="mozac_browser_errorpages_net_reset_message"><![CDATA[<p>Kết nối mạng đã bị gián đoạn trong quá trình thiết lập. Vui lòng thử lại.</p>\n<ul>\n<li>Trang web có thể tạm thời không khả dụng hoặc quá tải. Hãy đợi một lúc và thử lại sau.</li>\n<li>Nếu bạn không thể tải bất kỳ trang nào, hãy kiểm tra kết nối dữ liệu hoặc kết nối Wi-Fi trên thiết bị của bạn.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_reset_title">Kết nối đã được thiết lập lại</string>
    <string name="mozac_browser_errorpages_net_timeout_message"><![CDATA[<p>Trang web được yêu cầu không phản hồi yêu cầu kết nối và trình duyệt đã dừng chờ trả lời.</p>\n<ul>\n<li>Máy chủ có thể gặp phải nhu cầu cao hoặc ngừng hoạt động tạm thời? Thử lại sau.</li>\n<li>Bạn không thể duyệt các trang web khác? Kiểm tra kết nối mạng máy tính.</li>\n<li>Máy tính hoặc mạng của bạn được bảo vệ bởi tường lửa hoặc proxy? Cài đặt không chính xác có thể can thiệp vào trình duyệt Web.</li>\n<li>Vẫn gặp sự cố? Tham khảo ý kiến ​​quản trị viên mạng hoặc nhà cung cấp Internet của bạn để được hỗ trợ.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_net_timeout_title">Kết nối đã quá hạn</string>
    <string name="mozac_browser_errorpages_no_internet_error_code">Mã lỗi: NS_ERROR_OFFLINE</string>
    <string name="mozac_browser_errorpages_no_internet_message_2">Hãy thử kết nối trên thiết bị khác. Kiểm tra modem hoặc bộ định tuyến của bạn. Ngắt kết nối và kết nối lại với Wi-Fi.</string>
    <string name="mozac_browser_errorpages_no_internet_refresh_button">Tải lại</string>
    <string name="mozac_browser_errorpages_no_internet_title_2">Có vẻ như đã xảy ra sự cố với kết nối Internet của bạn</string>
    <string name="mozac_browser_errorpages_offline_message"><![CDATA[<p>Trình duyệt đang hoạt động ở chế độ ngoại tuyến và không thể kết nối với mục được yêu cầu.</p>\n<ul>\n<li>Máy tính có được kết nối với mạng đang hoạt động không?</li>\n<li>Nhấp “Thử lại” để chuyển sang chế độ trực tuyến và tải lại trang.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_offline_title">Chế độ ngoại tuyến</string>
    <string name="mozac_browser_errorpages_page_refresh">Thử lại</string>
    <string name="mozac_browser_errorpages_port_blocked_message"><![CDATA[<p>Địa chỉ được yêu cầu chỉ định một cổng (ví dụ: <q>mozilla.org:80</q> cho port 80 trên mozilla.org) thường được sử dụng cho những mục đích <em>khác</em> hơn là duyệt Web. Trình duyệt đã hủy yêu cầu vì lý do bảo vệ và bảo mật của bạn.</p>]]></string>
    <string name="mozac_browser_errorpages_port_blocked_title">Port bị hạn chế vì lý do an ninh</string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_message"><![CDATA[<p>Trình duyệt được cấu hình để sử dụng máy chủ proxy, nhưng proxy đã từ chối kết nối.</p>\n<ul>\n<li>Cấu hình proxy của trình duyệt có đúng không? Kiểm tra cài đặt và thử lại.</li>\n<li>Dịch vụ proxy có cho phép kết nối từ mạng này không?</li>\n<li>Vẫn gặp sự cố? Tham khảo ý kiến ​​quản trị viên mạng hoặc nhà cung cấp dịch vụ Internet của bạn để được hỗ trợ.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_proxy_connection_refused_title">Máy chủ proxy từ chối kết nối</string>
    <string name="mozac_browser_errorpages_redirect_loop_message"><![CDATA[<p>Trình duyệt đã ngừng cố gắng truy xuất mục được yêu cầu. Trang web đang chuyển hướng yêu cầu theo cách không bao giờ hoàn thành.</p>\n<ul>\n<li>Có phải bạn đã vô hiệu hóa hoặc chặn cookie theo yêu cầu của trang web này?</li>\n<li>Nếu chấp nhận cookie của trang web không giải quyết được vấn đề, có thể cấu hình máy chủ và máy tính của bạn có vấn đề .</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_redirect_loop_title">Trang này chuyển hướng không đúng cách</string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_message"><![CDATA[<p>Trang web tại %1$s đã được báo cáo là một trang web tấn công và đã bị chặn dựa trên tùy chọn bảo mật của bạn.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_malware_uri_title">Sự cố với trang web có mã độc</string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_message"><![CDATA[<p>Trang web tại %1$s đã được báo cáo là cung cấp phần mềm không mong muốn và đã bị chặn dựa trên tùy chọn bảo mật của bạn.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_browsing_unwanted_uri_title">Sự cố với trang web không mong muốn</string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_message"><![CDATA[<p>Trang web tại %1$s đã được báo cáo là một trang web có khả năng gây hại và đã bị chặn dựa trên các tùy chọn bảo mật của bạn.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_harmful_uri_title">Sự cố trang web gây hại</string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_message"><![CDATA[<p>Trang web này tại %1$s đã được báo cáo là trang lừa đảo và đã bị chặn dựa trên tùy chọn bảo mật của bạn.</p>]]></string>
    <string name="mozac_browser_errorpages_safe_phishing_uri_title">Sự cố với trang web lừa đảo</string>
    <string name="mozac_browser_errorpages_security_bad_cert_accept_temporary">Chấp nhận rủi ro và tiếp tục</string>
    <string name="mozac_browser_errorpages_security_bad_cert_advanced">Nâng cao…</string>
    <string name="mozac_browser_errorpages_security_bad_cert_back">Quay lại (Khuyến nghị)</string>
    <string name="mozac_browser_errorpages_security_bad_cert_message"><![CDATA[<ul>\n<li>Đây có thể là một vấn đề với cấu hình máy chủ, hoặc có thể ai đó đang cố gắng mạo danh máy chủ này.</li>\n<li>Nếu trước đây bạn đã kết nối với máy chủ này thành công thì có khả năng lỗi này chỉ là tạm thời và bạn có thể thử lại sau.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_techInfo"><![CDATA[<label>Ai đó có thể đang cố gắng mạo danh trang web và bạn không nên tiếp tục.</label> <br><br>\n<label>Trang web chứng minh danh tính của họ thông qua các chứng chỉ. %1$s không tin tưởng <b>%2$s</b> vì tổ chức phát hành chứng chỉ không xác định, chứng chỉ tự ký, hoặc máy chủ không gửi chứng chỉ trung gian chính xác.</label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_cert_title">Kết nối bảo mật đã thất bại</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_advanced">Nâng cao…</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_back">Quay lại</string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_message"><![CDATA[<ul>\n<li>Không thể hiển thị trang web bạn đang cố gắng truy cập vì nó yêu cầu kết nối an toàn.</li>\n<li>Rất có thể đã xảy ra sự cố với trang web và bạn không thể làm gì để giải quyết nó.</li>\n<li>Bạn có thể thông báo cho quản trị viên của trang web về sự cố.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_techInfo2"><![CDATA[<label> <b>%1$s</b> có chính sách bảo mật được gọi là Bảo mật truyền tải nghiêm ngặt HTTP (HSTS), có nghĩa là <b>%2$s</b> chỉ có thể kết nối với nó một cách an toàn. Bạn không thể thêm ngoại lệ để truy cập trang web này. </label>]]></string>
    <string name="mozac_browser_errorpages_security_bad_hsts_cert_title">Trang web này yêu cầu kết nối an toàn.</string>
    <string name="mozac_browser_errorpages_security_ssl_message"><![CDATA[<ul>\n<li>Trang bạn đang cố gắng truy cập không thể hiển thị vì không thể xác minh tính xác thực của dữ liệu nhận được.</li>\n<li>Bạn hãy liên hệ với chủ sở hữu trang web để thông báo về sự cố này nếu có thể.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_security_ssl_title">Kết nối bảo mật đã thất bại</string>
    <string name="mozac_browser_errorpages_unknown_host_message"><![CDATA[<p>Trình duyệt không thể tìm thấy máy chủ lưu trữ cho địa chỉ được cung cấp.</p>\n<ul>\n<li>Kiểm tra địa chỉ cho các lỗi đánh máy như <strong>ww</strong>.example.com thay cho <strong>www</strong>.example.com.</li>\n<li>Nếu bạn không thể tải bất kỳ trang nào, hãy kiểm tra kết nối dữ liệu hoặc kết nối Wi-Fi trên thiết bị của bạn.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_host_title">Không tìm thấy địa chỉ</string>
    <string name="mozac_browser_errorpages_unknown_protocol_message"><![CDATA[<p>Địa chỉ chỉ định một giao thức (e.g., <q>wxyz://</q>) trình duyệt không nhận ra, vì vậy trình duyệt không thể kết nối đúng với trang web.</p>\n<ul>\n<li>Bạn đang cố gắng truy cập đa phương tiện hoặc các dịch vụ phi văn bản khác? Kiểm tra các trang web cho các yêu cầu thêm.</li>\n<li>Một số giao thức có thể yêu cầu phần mềm hoặc plugin của bên thứ ba trước khi trình duyệt có thể nhận ra chúng.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_protocol_title">Giao thức không xác định</string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_message"><![CDATA[<p>Trình duyệt được cấu hình để sử dụng máy chủ proxy, nhưng không thể tìm thấy proxy.</p>\n<ul>\n<li>Cấu hình proxy của trình duyệt có đúng không? Kiểm tra cài đặt và thử lại.</li>\n<li>Máy tính có được kết nối với mạng đang hoạt động không?</li>\n<li>Vẫn gặp sự cố? Tham khảo ý kiến ​​quản trị viên mạng hoặc nhà cung cấp dịch vụ Internet của bạn để được hỗ trợ.</li>\n</ul>]]></string>
    <string name="mozac_browser_errorpages_unknown_proxy_host_title">Không tìm thấy máy chủ proxy</string>
    <string name="mozac_browser_errorpages_unknown_socket_type_message"><![CDATA[<p>Trang web đã phản hồi yêu cầu mạng theo cách không mong muốn và trình duyệt không thể tiếp tục.</p>]]></string>
    <string name="mozac_browser_errorpages_unknown_socket_type_title">Phản hồi không mong muốn từ máy chủ</string>
    <string name="mozac_browser_errorpages_unsafe_content_type_message"><![CDATA[<ul>\n<li>Vui lòng liên hệ với các chủ sở hữu trang web để thông báo cho họ về vấn đề này.</li>\n</ul>]]></string>
