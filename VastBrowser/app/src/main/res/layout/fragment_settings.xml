<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="28sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Two-column content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- LEFT COLUMN -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="16dp">

            <!-- Home Page -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_home_page"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edit_home_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textUri"
                android:singleLine="true"
                android:focusable="true"
                android:layout_marginBottom="16dp" />

            <!-- Nav Method -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_nav_method"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/radio_nav_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/radio_nav_surfing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_method_surfing"
                    android:textColor="@color/text_primary"
                    android:focusable="true" />

                <RadioButton
                    android:id="@+id/radio_nav_cursor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_method_cursor"
                    android:textColor="@color/text_primary"
                    android:focusable="true" />
            </RadioGroup>

            <!-- Triple-up toggle -->
            <CheckBox
                android:id="@+id/checkbox_triple_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3× Up-press shows address bar"
                android:textColor="@color/text_primary"
                android:focusable="true"
                android:checked="true" />

        </LinearLayout>

        <!-- Vertical divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF"
            android:layout_marginHorizontal="8dp" />

        <!-- RIGHT COLUMN -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <!-- Cursor Timeout -->
            <TextView
                android:id="@+id/label_cursor_timeout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_cursor_timeout"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_cursor_timeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:backgroundTint="@color/icon_primary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edit_custom_timeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:hint="@string/custom_timeout_hint"
                android:inputType="number"
                android:singleLine="true"
                android:focusable="true"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Scroll Hold Duration -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scroll Mode Hold Duration"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_scroll_hold_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:backgroundTint="@color/icon_primary" />

        </LinearLayout>
    </LinearLayout>

    <!-- Save button at the bottom -->
    <Button
        android:id="@+id/button_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/save_settings"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:focusable="true" />
</LinearLayout>
