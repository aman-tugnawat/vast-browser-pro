<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusable="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="32sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_home_page"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_home_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:inputType="textUri"
            android:singleLine="true"
            android:focusable="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_nav_method"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radio_nav_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            
            <RadioButton
                android:id="@+id/radio_nav_surfing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_method_surfing"
                android:textColor="@color/text_primary"
                android:focusable="true" />
                
            <RadioButton
                android:id="@+id/radio_nav_cursor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_method_cursor"
                android:textColor="@color/text_primary"
                android:focusable="true" />
        </RadioGroup>

        <TextView
            android:id="@+id/label_cursor_timeout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_cursor_timeout"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_cursor_timeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:backgroundTint="@color/icon_primary"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_custom_timeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:hint="@string/custom_timeout_hint"
            android:inputType="number"
            android:singleLine="true"
            android:focusable="true"
            android:visibility="gone"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/button_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_settings"
            android:layout_marginTop="24dp"
            android:focusable="true" />
    </LinearLayout>
</ScrollView>
