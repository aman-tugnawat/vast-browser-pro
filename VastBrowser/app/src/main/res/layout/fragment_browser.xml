<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Browser engine view (declared first so toolbar/progressbar overlay on top) -->
    <mozilla.components.browser.engine.system.SystemEngineView
        android:id="@+id/engineView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/toolbar_background"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:focusable="true"
            android:tint="@color/icon_primary" />

        <ImageButton
            android:id="@+id/button_forward"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_forward"
            android:src="@drawable/ic_forward"
            android:scaleType="centerInside"
            android:focusable="true"
            android:tint="@color/icon_primary" />

        <ImageButton
            android:id="@+id/button_reload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_reload"
            android:src="@drawable/ic_reload"
            android:scaleType="centerInside"
            android:focusable="true"
            android:tint="@color/icon_primary" />

        <EditText
            android:id="@+id/url_input"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/url_bar_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp"
            android:hint="@string/url_bar_hint"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:selectAllOnFocus="true"
            tools:text="https://mozilla.org" />

        <ImageButton
            android:id="@+id/button_home"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:src="@drawable/ic_home"
            android:scaleType="centerInside"
            android:focusable="true"
            android:tint="@color/icon_primary" />

        <ImageButton
            android:id="@+id/button_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:focusable="true"
            android:tint="@color/icon_primary" />
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:progressDrawable="@drawable/progress_bar_drawable"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible"
        tools:progress="50" />

    <!-- D-Pad Cursor Group -->
    <FrameLayout
        android:id="@+id/cursor_group"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/cursor_ring"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/cursor_ring" />

        <ImageView
            android:id="@+id/cursor_disk"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_open_with"
            android:background="@drawable/cursor_scroll_mode"
            android:padding="4dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/cursor_arrow_up"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|center_horizontal"
            android:src="@drawable/ic_scroll_arrow"
            android:alpha="0" />

        <ImageView
            android:id="@+id/cursor_arrow_down"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|center_horizontal"
            android:src="@drawable/ic_scroll_arrow"
            android:rotation="180"
            android:alpha="0" />

        <ImageView
            android:id="@+id/cursor_arrow_left"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/ic_scroll_arrow"
            android:rotation="270"
            android:alpha="0" />

        <ImageView
            android:id="@+id/cursor_arrow_right"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/ic_scroll_arrow"
            android:rotation="90"
            android:alpha="0" />
    </FrameLayout>

    <!-- Hover details / tooltip overlay -->
    <TextView
        android:id="@+id/cursor_tooltip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tooltip_background"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        android:elevation="12dp"
        android:maxWidth="320dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Tooltip text details" />

    <!-- Scroll mode status text -->
    <TextView
        android:id="@+id/scroll_mode_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scroll mode started."
        android:textColor="#B3FFFFFF"
        android:textSize="16sp"
        android:background="#66000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:alpha="0"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
