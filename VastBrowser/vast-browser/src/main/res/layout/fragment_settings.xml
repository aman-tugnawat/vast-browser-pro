<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="28sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Two-column content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- LEFT COLUMN -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="16dp">

            <!-- Home Page -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_home_page"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edit_home_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textUri"
                android:singleLine="true"
                android:focusable="true"
                android:layout_marginBottom="16dp" />

            <!-- Nav Method -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_nav_method"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/radio_nav_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/radio_nav_surfing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_method_surfing"
                    android:textColor="@color/text_primary"
                    android:focusable="true" />

                <RadioButton
                    android:id="@+id/radio_nav_cursor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_method_cursor"
                    android:textColor="@color/text_primary"
                    android:focusable="true" />
            </RadioGroup>

            <!-- Triple-up toggle -->
            <CheckBox
                android:id="@+id/checkbox_triple_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3× Up-press shows address bar"
                android:textColor="@color/text_primary"
                android:focusable="true"
                android:checked="true" />

        </LinearLayout>

        <!-- Vertical divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF"
            android:layout_marginHorizontal="8dp" />

        <!-- RIGHT COLUMN -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <!-- Cursor Timeout -->
            <TextView
                android:id="@+id/label_cursor_timeout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_cursor_timeout"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_cursor_timeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:backgroundTint="@color/icon_primary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edit_custom_timeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:hint="@string/custom_timeout_hint"
                android:inputType="number"
                android:singleLine="true"
                android:focusable="true"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Scroll Hold Duration -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scroll Mode Hold Duration"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_scroll_hold_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:backgroundTint="@color/icon_primary" />

            <!-- Cursor Speed -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cursor Movement Speed"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_cursor_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:backgroundTint="@color/icon_primary" />

        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginVertical="16dp" />

    <!-- ===== SYSTEM EXTENSIONS SECTION ===== -->
    <LinearLayout
        android:id="@+id/container_system_extensions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Section header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_extension"
                android:tint="@color/icon_primary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/extensions_title"
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ads Blocker Row -->
        <LinearLayout
            android:id="@+id/extension_row_system_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/url_bar_background"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_ublock"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/extensions_ublock_name"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/extensions_ublock_desc"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/system_ads_blocked_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 blocked"
                android:textSize="11sp"
                android:textColor="@color/accent"
                android:background="#22FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="8dp" />

            <Switch
                android:id="@+id/switch_system_ads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/button_system_ads_details"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/extensions_details"
                android:textSize="12sp"
                android:focusable="true"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- Tracker Blocker Row -->
        <LinearLayout
            android:id="@+id/extension_row_system_tracker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/url_bar_background"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_privacy_badger"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/extensions_privacybadger_name"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/extensions_privacybadger_desc"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/system_tracker_blocked_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 blocked"
                android:textSize="11sp"
                android:textColor="@color/accent"
                android:background="#22FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="8dp" />

            <Switch
                android:id="@+id/switch_system_tracker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/button_system_tracker_details"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/extensions_details"
                android:textSize="12sp"
                android:focusable="true"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginVertical="16dp" />

    <!-- ===== ABOUT & UPDATES SECTION ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_updates_title"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/text_current_version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Current Version: --"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/text_engine_version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Engine Version: --"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_update_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_up_to_date"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkbox_notify_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_notify_update"
            android:textColor="@color/text_primary"
            android:focusable="true"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_last_checked"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/about_never_checked"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/button_check_update"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/about_check_now"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/button_download_update"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/about_download_update"
                android:textSize="12sp"
                android:focusable="true"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Save button at the bottom -->
    <Button
        android:id="@+id/button_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/save_settings"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:focusable="true" />
</LinearLayout>
</ScrollView>
